@import "../../styles/motion.wxss";
:host {
  pointer-events: none;
}
.feedback-layer {
  position: fixed;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
}
.feedback-layer--loading {
  z-index: 20000;
}
.feedback-layer--toast {
  z-index: 20010;
}
.feedback-mask {
  position: absolute;
  inset: 0;
  background: rgba(24, 39, 65, 0.2);
  pointer-events: auto;
}
.feedback-mask--toast {
  background: transparent;
}
.feedback-loading {
  position: relative;
  box-sizing: border-box;
  width: 244rpx;
  padding: 38rpx 28rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
  border: 1rpx solid rgba(220, 228, 242, 0.8);
  border-radius: 28rpx;
  background: #fff;
  box-shadow: 0 18rpx 70rpx rgba(26, 47, 86, 0.16);
}
.feedback-loading__title {
  max-width: 100%;
  color: #202b40;
  font-size: 26rpx;
  line-height: 1.5;
  text-align: center;
  overflow-wrap: break-word;
}
.feedback-spinner {
  box-sizing: border-box;
  width: 48rpx;
  height: 48rpx;
  flex-shrink: 0;
  border: 5rpx solid #e8effd;
  border-top-color: #2864eb;
  border-radius: 50%;
  animation: feedback-spin 0.8s linear infinite;
}
.feedback-toast {
  position: relative;
  box-sizing: border-box;
  max-width: 580rpx;
  margin: 0 48rpx;
  padding: 24rpx 32rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  border-radius: 22rpx;
  color: #fff;
  background: rgba(32, 43, 64, 0.96);
  box-shadow: 0 12rpx 48rpx rgba(16, 28, 48, 0.2);
}
.feedback-toast__title {
  min-width: 0;
  font-size: 28rpx;
  line-height: 1.6;
  text-align: center;
  overflow-wrap: break-word;
}
.feedback-icon {
  position: relative;
  box-sizing: border-box;
  width: 34rpx;
  height: 34rpx;
  flex-shrink: 0;
  border: 2rpx solid rgba(255, 255, 255, 0.75);
  border-radius: 50%;
}
.feedback-icon--success {
  border-color: #86e1c0;
}
.feedback-icon--success::after {
  content: "";
  position: absolute;
  top: 7rpx;
  left: 8rpx;
  width: 12rpx;
  height: 7rpx;
  border-left: 3rpx solid #86e1c0;
  border-bottom: 3rpx solid #86e1c0;
  transform: rotate(-45deg);
}
.feedback-icon--error {
  border-color: #ffb2b8;
}
.feedback-icon--error::before,
.feedback-icon--error::after {
  content: "";
  position: absolute;
  top: 13rpx;
  left: 6rpx;
  width: 18rpx;
  height: 3rpx;
  border-radius: 2rpx;
  background: #ffb2b8;
  transform: rotate(45deg);
}
.feedback-icon--error::after {
  transform: rotate(-45deg);
}
.feedback-icon__info {
  display: block;
  color: #fff;
  font-size: 23rpx;
  font-weight: 600;
  line-height: 30rpx;
  text-align: center;
}
.feedback-icon--loading {
  border: 0;
}
.feedback-spinner--small {
  width: 34rpx;
  height: 34rpx;
  border-width: 3rpx;
  border-color: rgba(255, 255, 255, 0.2);
  border-top-color: #fff;
}
@keyframes feedback-spin {
  to {
    transform: rotate(360deg);
  }
}
@media (prefers-reduced-motion: reduce) {
  .feedback-spinner {
    animation: none;
  }
}
