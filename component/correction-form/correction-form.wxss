.form-card {
  padding: 22px 20px;
  border-radius: 22px;
  background: #fff;
}
.field-heading {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 12px;
}
.field-title {
  font-size: 15px;
  font-weight: 600;
  color: #35435a;
  line-height: 1.5;
}
.field-hint {
  margin-left: 8px;
  color: #8b97aa;
  font-size: 11px;
  line-height: 1.5;
}
.feedback-types {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-start;
  column-gap: 9px;
}
.feedback-type {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  width: calc(33.333% - 6px);
  min-height: 46px;
  margin-bottom: 10px;
  padding: 10px 7px;
  border: 1px solid #e6ebf3;
  border-radius: 12px;
  background: #f8fafd;
  color: #5e6c83;
}
.feedback-type--checked {
  border-color: #91b2ff;
  background: #eff5ff;
  color: #2864eb;
}
.feedback-type--disabled {
  opacity: 0.65;
}
.feedback-native-checkbox {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100%;
  opacity: 0;
}
.feedback-type-label {
  min-width: 0;
  font-size: 13px;
  line-height: 1.6;
}
.feedback-type-check {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-sizing: border-box;
  width: 17px;
  height: 17px;
  margin-left: 3px;
  border: 1px solid #d6deeb;
  border-radius: 6px;
  background: #fff;
}
.feedback-type-check--checked {
  border-color: #2864eb;
  background: #2864eb;
}
.feedback-check-mark {
  width: 8px;
  height: 5px;
  margin-top: -2px;
  border-left: 2px solid #fff;
  border-bottom: 2px solid #fff;
  transform: rotate(-45deg);
}
.remark-heading {
  margin-top: 20px;
}
.remark {
  display: block;
  box-sizing: border-box;
  width: 100%;
  height: 144px;
  padding: 12px;
  border: 1px solid #e3eaf5;
  border-radius: 13px;
  background: #f7f9fd;
  color: #35435a;
  font-size: 14px;
  line-height: 1.7;
}
.captcha-heading {
  margin-top: 24px;
}
.captcha-row {
  display: flex;
  align-items: center;
}
.captcha-input {
  box-sizing: border-box;
  flex: 1;
  min-width: 0;
  height: 48px;
  padding: 0 12px;
  border: 1px solid #e3eaf5;
  border-radius: 11px;
  background: #f7f9fd;
  color: #35435a;
  font-size: 14px;
}
.captcha-image {
  flex-shrink: 0;
  width: 94px;
  height: 48px;
  margin-left: 10px;
  border: 1px solid #e3eaf5;
  border-radius: 11px;
  background: #fff;
}
.correction-form .correction-submit {
  width: 100%;
  height: 48px;
  margin: 20px 0 0;
  padding: 0;
  border: 0;
  border-radius: 14px;
  background: #2864eb;
  color: #fff;
  font-size: 16px;
  font-weight: 600;
  line-height: 48px;
}
.correction-submit::after {
  border: none;
}
.correction-form .correction-submit[disabled] {
  background: #a7bce7;
  color: #fff;
}
@media (max-width: 340px) {
  .form-card {
    padding: 20px 18px;
  }
  .feedback-type {
    width: calc(50% - 5px);
  }
}
