<button class="favorite-action {{compact ? 'favorite-action-compact' : ''}} {{favorite && known ? 'favorite-action-selected' : ''}}" bindtap="toggleFavorite" disabled="{{loading || saving}}" aria-label="{{loading ? '正在读取收藏状态' : (saving ? '正在保存收藏' : (error ? '重试收藏状态' : (favorite ? '取消收藏' : '收藏')))}}" hover-class="favorite-action-pressed" hover-start-time="0" hover-stay-time="80"><image wx:if="{{favorite && known}}" src="/images/ui-favorite-active.png" mode="aspectFit" aria-hidden="true" /><image wx:else src="/images/ui-favorite.png" mode="aspectFit" aria-hidden="true" /><text wx:if="{{!compact}}">{{saving ? '保存中' : (loading ? '加载中' : (error ? '重试' : (favorite ? '已收藏' : '收藏')))}}</text></button>
