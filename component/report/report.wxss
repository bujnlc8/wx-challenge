@import "../../styles/motion.wxss";
.board {
  position: fixed;
  z-index: 10005;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(20, 32, 53, 0.48);
}
.feedback {
  position: fixed;
  z-index: 10006;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  width: calc(100% - 32px);
  max-width: 420px;
  max-height: 88vh;
  overflow: hidden;
  border: 1px solid rgba(226, 235, 249, 0.8);
  border-radius: 24px;
  background: #fff;
  box-shadow: 0 24px 80px rgba(20, 38, 70, 0.2);
}
.feedback-header {
  position: relative;
  flex-shrink: 0;
  padding: 20px 62px 14px 22px;
  background: linear-gradient(135deg, #f1f6ff 0%, #fff 88%);
}
.feedback-title {
  color: #202b40;
  font-size: 18px;
  font-weight: 700;
  line-height: 1.5;
  letter-spacing: 0.3px;
}
.feedback-caption {
  margin-top: 5px;
  color: #7b88a0;
  font-size: 12px;
  line-height: 1.7;
}
.feedback .feedback-close {
  position: absolute;
  top: 13px;
  right: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 44px;
  height: 44px;
  margin: 0;
  padding: 0;
  border-radius: 50%;
  background: transparent;
  line-height: normal;
}
.feedback-close::after,
.feedback-submit::after {
  border: none;
}
.close-mark {
  position: relative;
  width: 18px;
  height: 18px;
}
.close-mark::before,
.close-mark::after {
  content: "";
  position: absolute;
  top: 8px;
  left: 1px;
  width: 16px;
  height: 2px;
  border-radius: 1px;
  background: #8a97ac;
  transform: rotate(45deg);
}
.close-mark::after {
  transform: rotate(-45deg);
}
.feedback-body {
  min-height: 0;
  max-height: calc(88vh - 170px);
  flex: 0 1 auto;
  overflow-y: auto;
  padding: 0 22px 20px;
  overscroll-behavior: contain;
}
.feedback-field-heading {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 11px;
}
.feedback-label-title {
  color: #35435a;
  font-size: 14px;
  font-weight: 600;
  line-height: 1.5;
}
.feedback-field-hint {
  margin-left: 8px;
  color: #8b97aa;
  font-size: 11px;
  line-height: 1.5;
}
.feedback-types {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-start;
  column-gap: 9px;
}
.feedback-type {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  width: calc(33.333% - 6px);
  min-height: 46px;
  margin-bottom: 9px;
  padding: 10px 7px;
  border: 1px solid #e6ebf3;
  border-radius: 12px;
  background: #f8fafd;
  color: #5e6c83;
}
.feedback-type--checked {
  border-color: #91b2ff;
  background: #eff5ff;
  color: #2864eb;
}
.feedback-type--disabled {
  opacity: 0.65;
}
.feedback-native-checkbox {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100%;
  opacity: 0;
}
.feedback-type-label {
  min-width: 0;
  font-size: 13px;
  line-height: 1.6;
  font-weight: 500;
}
.feedback-type-check {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  flex-shrink: 0;
  width: 17px;
  height: 17px;
  margin-left: 3px;
  border: 1px solid #d6deeb;
  border-radius: 6px;
  background: #fff;
}
.feedback-type-check--checked {
  border-color: #2864eb;
  background: #2864eb;
}
.feedback-check-mark {
  box-sizing: border-box;
  width: 8px;
  height: 5px;
  margin-top: -2px;
  border-left: 2px solid #fff;
  border-bottom: 2px solid #fff;
  transform: rotate(-45deg);
}
.feedback-field-heading--remark {
  margin-top: 11px;
}
.remark-field {
  overflow: hidden;
  border: 1px solid #e3eaf5;
  border-radius: 13px;
  background: #f7f9fd;
}
.remark-field:focus-within {
  border-color: #91b2ff;
  background: #fff;
}
.remark {
  box-sizing: border-box;
  width: 100%;
  height: 86px;
  padding: 11px 12px 0;
  color: #35435a;
  font-size: 14px;
  line-height: 1.75;
}
.remark-count {
  padding: 4px 12px 9px;
  color: #9aa6b8;
  font-size: 11px;
  line-height: 1.5;
  text-align: right;
}
.feedback-verification {
  flex-shrink: 0;
  padding: 0 22px 16px;
  background: #fff;
}
.feedback-field-heading--captcha {
  margin-top: 0;
  margin-bottom: 10px;
}
.captcha-row {
  display: flex;
  align-items: center;
}
.captcha-input {
  box-sizing: border-box;
  flex: 1;
  min-width: 0;
  height: 46px;
  padding: 0 12px;
  border: 1px solid #e3eaf5;
  border-radius: 11px;
  background: #f7f9fd;
  color: #35435a;
  font-size: 14px;
}
.captcha-image-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-sizing: border-box;
  width: 94px;
  height: 46px;
  margin-left: 10px;
  overflow: hidden;
  border: 1px solid #e3eaf5;
  border-radius: 11px;
  background: #fff;
}
.captcha-image {
  width: 83px;
  height: 42px;
}
.feedback-footer {
  flex-shrink: 0;
  padding: 15px 22px 18px;
  border-top: 1px solid #edf1f7;
  background: #fff;
}
.feedback .feedback-submit {
  box-sizing: border-box;
  width: 100%;
  min-width: 0;
  height: 48px;
  line-height: 48px;
  padding: 0;
  margin: 0;
  border: 0;
  border-radius: 13px;
  background: linear-gradient(110deg, #3978f5, #2864eb);
  box-shadow: 0 5px 12px rgba(40, 100, 235, 0.16);
  color: #fff;
  font-size: 15px;
  font-weight: 600;
}
.feedback .feedback-submit[disabled] {
  background: #a7bce7;
  color: #fff;
  box-shadow: none;
}
@media (max-width: 340px) {
  .feedback-header {
    padding-left: 18px;
  }
  .feedback-body {
    padding-right: 18px;
    padding-left: 18px;
  }
  .feedback-caption {
    font-size: 11px;
  }
  .feedback-type {
    width: calc(50% - 5px);
    padding-right: 9px;
    padding-left: 9px;
  }
  .feedback-footer,
  .feedback-verification {
    padding-right: 18px;
    padding-left: 18px;
  }
}

.feedback--keyboard .feedback-header {
  padding-top: 14px;
  padding-bottom: 12px;
}
.feedback--keyboard .feedback-caption {
  display: none;
}
.feedback--keyboard .feedback-footer {
  padding-top: 10px;
  padding-bottom: 12px;
}

.feedback--keyboard .feedback-verification {
  padding-bottom: 10px;
}
