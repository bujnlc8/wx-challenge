<view class="board" wx:if="{{show_feedback}}" catchtap="catchtouchmove" catchtouchmove="catchtouchmove"></view>
<view wx:if="{{show_feedback}}" class="feedback {{keyboard_height > 0 ? 'feedback--keyboard' : ''}}" style="{{keyboard_height > 0 ? 'top: 12px; transform: translateX(-50%); max-height: calc(100vh - ' + (keyboard_height + 24) + 'px);' : ''}}" catchtap="catchtouchmove" aria-role="dialog" aria-label="题目纠错">
  <view class="feedback-header">
    <view class="feedback-title">题目纠错</view>
    <view class="feedback-caption">选择问题类型，或补充具体说明</view>
    <button class="feedback-close" bindtap="closeFeedback" aria-label="关闭题目纠错" hover-class="button-pressed" hover-start-time="20" hover-stay-time="80"><view class="close-mark"></view></button>
  </view>
  <view class="feedback-body">
    <view class="feedback-field-heading"><text class="feedback-label-title">问题类型</text><text class="feedback-field-hint">可多选</text></view>
    <checkbox-group bindchange="feedbackChecked">
      <view class="feedback-types">
        <label wx:for="{{feedback_options}}" wx:key="value" class="feedback-type {{item.checked ? 'feedback-type--checked' : ''}} {{submit_pending ? 'feedback-type--disabled' : ''}}">
          <checkbox class="feedback-native-checkbox" value="{{item.value}}" checked="{{item.checked}}" disabled="{{submit_pending}}" />
          <text class="feedback-type-label">{{item.label}}</text><view class="feedback-type-check {{item.checked ? 'feedback-type-check--checked' : ''}}"><view wx:if="{{item.checked}}" class="feedback-check-mark"></view></view>
        </label>
      </view>
    </checkbox-group>
    <view class="feedback-field-heading feedback-field-heading--remark"><text class="feedback-label-title">补充说明</text></view>
    <view class="remark-field">
      <textarea placeholder="例如：正确答案应为 B，解析中的年份有误" class="remark" value="{{feedback_remark}}" placeholder-style="font-size:14px;color:#94a0b3;" bindinput="feedbackRemarkInput" bindkeyboardheightchange="feedbackKeyboardChange" maxlength="500" disabled="{{submit_pending}}" adjust-position="false" cursor-spacing="16"></textarea>
      <view class="remark-count">{{feedback_remark.length}} / 500</view>
    </view>
    <view class="feedback-field-heading feedback-field-heading--captcha"><text class="feedback-label-title">验证码</text><text class="feedback-field-hint">点击图片换一张</text></view>
    <view class="captcha-row"><input type="number" class="captcha-input" maxlength="6" placeholder="输入 6 位数字" placeholder-style="color:#94a0b3;" bindinput="captchaInput" bindkeyboardheightchange="feedbackKeyboardChange" disabled="{{submit_pending}}" adjust-position="false" value="{{captcha_data}}" /><view class="captcha-image-wrap"><image bindtap="getCaptcha" src="data:image/png;base64,{{captcha_image}}" class="captcha-image" aria-label="点击刷新验证码"></image></view></view>
  </view>
  <view class="feedback-footer"><button class="feedback-submit" disabled="{{submit_pending}}" bindtap="feedbackSubmit" hover-class="button-pressed" hover-start-time="20" hover-stay-time="80">{{submit_pending ? '正在提交…' : '提交纠错'}}</button></view>
</view>
