function indexOf(arr, value) {
  if (arr.indexOf(value) < 0) {
    return false;
  } else {
    return true;
  }
}
module.exports.indexOf = indexOf;

function optionLabel(index) { return ["A", "B", "C", "D"][index] || ""; }
module.exports.optionLabel = optionLabel;

function htmlSpace(character) {
  return character === ' ' || character === '\n' || character === '\r' || character === '\t' || character.charCodeAt(0) === 12;
}

// Read a whole tag before looking inside it: quoted '>' is attribute data.
function tagEnd(html, start) {
  var quote = '';
  for (var index = start; index < html.length; index++) {
    var character = html.charAt(index);
    if (quote) {
      if (character === quote) quote = '';
    } else if (character === '"' || character === "'") {
      quote = character;
    } else if (character === '>') {
      return index;
    }
  }
  return -1;
}

function framedImage(tag) {
  var attributes = '';
  var styles = '';
  var index = 4;
  while (index < tag.length - 1) {
    while (htmlSpace(tag.charAt(index))) index++;
    if (tag.charAt(index) === '/' || index >= tag.length - 1) break;
    var start = index;
    while (index < tag.length - 1 && !htmlSpace(tag.charAt(index)) && tag.charAt(index) !== '=' && tag.charAt(index) !== '/') index++;
    var name = tag.slice(start, index).toLowerCase();
    // Keep malformed attributes unchanged rather than looping indefinitely.
    if (!name) return tag;
    while (htmlSpace(tag.charAt(index))) index++;
    var value = '';
    if (tag.charAt(index) === '=') {
      index++;
      while (htmlSpace(tag.charAt(index))) index++;
      var quote = tag.charAt(index);
      var valueStart = index;
      if (quote === '"' || quote === "'") {
        valueStart = ++index;
        while (index < tag.length - 1 && tag.charAt(index) !== quote) index++;
        value = tag.slice(valueStart, index);
        index++;
      } else {
        while (index < tag.length - 1 && !htmlSpace(tag.charAt(index))) index++;
        value = tag.slice(valueStart, index);
      }
    }
    if (name === 'style') {
      styles += value + ';';
    } else if (name !== 'width' && name !== 'height') {
      attributes += ' ' + tag.slice(start, index);
    }
  }
  // Override source dimensions and crop rules while retaining its other styles.
  styles += 'display:inline-block!important;position:static!important;float:none!important;transform:none!important;margin:0!important;box-sizing:border-box!important;min-width:0!important;min-height:0!important;width:auto!important;height:auto!important;max-width:100%!important;max-height:200px!important;object-fit:contain!important;vertical-align:middle!important;';
  styles = styles.replace(getRegExp('"', 'g'), '&quot;');
  return '<span style="display:inline-block;width:100%;height:200px;line-height:200px;text-align:center;font-size:0;vertical-align:middle;"><img' + attributes + ' style="' + styles + '"></span>';
}

function questionHtml(html) {
  if (!html) return html;
  var lower = html.toLowerCase();
  var output = '';
  var copied = 0;
  var index = 0;
  while (index < html.length) {
    var start = html.indexOf('<', index);
    if (start < 0) break;
    if (html.slice(start, start + 4) === '<!--') {
      var commentEnd = html.indexOf('-->', start + 4);
      if (commentEnd < 0) break;
      index = commentEnd + 3;
      continue;
    }
    var first = lower.charAt(start + 1);
    if ((first < 'a' || first > 'z') && first !== '/' && first !== '!' && first !== '?') {
      index = start + 1;
      continue;
    }
    var end = tagEnd(html, start + 1);
    if (end < 0) break;
    var nameEnd = start + 1;
    while (nameEnd < end && !htmlSpace(html.charAt(nameEnd)) && html.charAt(nameEnd) !== '/') nameEnd++;
    var name = lower.slice(start + 1, nameEnd);
    if (name === 'img') {
      output += html.slice(copied, start) + framedImage(html.slice(start, end + 1));
      copied = end + 1;
    } else if (name === 'script' || name === 'style' || name === 'textarea' || name === 'title') {
      // Content of raw-text elements is not HTML markup.
      var close = lower.indexOf('</' + name, end + 1);
      if (close < 0) break;
      index = close;
      continue;
    }
    index = end + 1;
  }
  return output + html.slice(copied);
}
module.exports.questionHtml = questionHtml;

function isRichQuestion(html) {
  if (!html) return false;
  return html.indexOf('/>') >= 0 || html.indexOf('</') >= 0 || questionHtml(html) !== html;
}
module.exports.isRichQuestion = isRichQuestion;

function elapsedTime(value) {
  var seconds = value - 0;
  if (seconds - seconds !== 0 || seconds < 0) seconds = 0;
  seconds = seconds - seconds % 1;
  var minutes = (seconds - seconds % 60) / 60;
  var hours = (minutes - minutes % 60) / 60;
  var secondText = seconds % 60 < 10 ? '0' + seconds % 60 : '' + seconds % 60;
  var minuteText = minutes % 60 < 10 ? '0' + minutes % 60 : '' + minutes % 60;
  return hours > 0 ? hours + ':' + minuteText + ':' + secondText : minuteText + ':' + secondText;
}
module.exports.elapsedTime = elapsedTime;
