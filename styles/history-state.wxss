.history-error-copy {
  margin: 12px 0 20px;
  color: #68758a;
  font-size: 14px;
  line-height: 1.8;
  word-break: break-word;
}
button.history-retry {
  width: auto;
  min-width: 120px;
  margin: 0 auto;
  padding: 10px 24px;
  border-radius: 12px;
  background: #2864eb;
  color: #fff;
  font-size: 14px;
  line-height: 1.8;
}
.history-retry::after {
  border: 0;
}
.history-more-error {
  padding: 12px 20px 24px;
  text-align: center;
}
.history-more-error .history-error-copy {
  margin-top: 0;
  margin-bottom: 10px;
}
.history-more-error button.history-retry {
  padding: 8px 20px;
  background: #e7efff;
  color: #2056ce;
}
