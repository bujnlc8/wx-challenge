@import "./styles/motion.wxss";

page {
  background: #f5f7fb;
  color: #202b40;
  font-size: 15px;
  line-height: 1.6;
  font-family:
    -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue",
    "Microsoft Yahei", sans-serif;
  -webkit-tap-highlight-color: transparent;
}
view,
scroll-view,
button,
input,
textarea {
  box-sizing: border-box;
}
button::after {
  border: none;
}
button {
  font-family: inherit;
}
.container {
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}
.page-shell {
  padding: 24px 20px 32px;
}
.page-title {
  font-size: 26px;
  line-height: 1.3;
  font-weight: 800;
  letter-spacing: -0.5px;
}
.page-subtitle {
  margin-top: 8px;
  color: #68758a;
  font-size: 14px;
}
.section-title {
  font-size: 18px;
  font-weight: 700;
}
.section-caption {
  color: #68758a;
  font-size: 12px;
}
.surface {
  background: #fff;
  border-radius: 20px;
  box-shadow: 0 4px 24px rgba(31, 54, 100, 0.035);
}
.primary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 54px;
  border-radius: 16px;
  background: #2864eb;
  color: #fff;
  font-size: 17px;
  font-weight: 700;
  box-shadow: 0 6px 16px rgba(40, 100, 235, 0.16);
}
.primary-button:active {
  background: #2056ce;
}
.blink_me {
  animation: blinker 3s linear infinite;
}
@keyframes blinker {
  50% {
    opacity: 0;
  }
}
.rule-item {
  padding: 6px 0;
  line-height: 1.85;
  font-size: 14px;
  color: #4e5c72;
}
.rule-item-indent {
  padding-left: 20px;
}
.hi-num {
  color: #2056ce;
  font-weight: 700;
}
.question-container {
  padding: 8px 20px 36px;
}
.question-toolbar {
  display: flex;
  align-items: center;
  min-height: 44px;
  margin-bottom: 20px;
}
.question-common {
  padding: 22px 18px;
  border-radius: 24px;
  background: #fff;
  box-shadow: 0 4px 24px rgba(31, 54, 100, 0.035);
}
.question-eyebrow {
  color: #2056ce;
  font-size: 13px;
  font-weight: 600;
  margin-bottom: 12px;
}
.question_body {
  font-size: 17px;
  line-height: 1.85;
  font-weight: 600;
  word-break: break-word;
}
.option-common {
  display: flex;
  align-items: center;
  min-height: 56px;
  margin-top: 12px;
  padding: 12px 16px;
  border: 1px solid #e3e9f2;
  border-radius: 14px;
  background: #f8faff;
  color: #35435a;
  font-size: 16px;
  line-height: 1.7;
  word-break: break-word;
}
.option_selected {
  background: #edf3ff;
  border-color: #2864eb;
  color: #2056ce;
  font-weight: 600;
}
.answer_result0 {
  background: #fff0f0 !important;
  border-color: #eaa7aa !important;
  color: #ad3542 !important;
  font-weight: 600;
}
.answer_result1 {
  background: #eaf8f1 !important;
  border-color: #84c7a6 !important;
  color: #19764d !important;
  font-weight: 600;
}
.image-option {
  width: 166px;
  max-width: 85%;
  border-radius: 8px;
  margin-left: 4px;
}
.quiz-card .image-question {
  display: block;
  width: 100%;
  height: 200px;
  object-fit: contain;
  background: #f5f8ff;
  margin: 16px auto;
  border-radius: 12px;
}
.quiz-card .video-option {
  width: 100%;
  height: 200px;
  object-fit: contain;
  margin: 16px 0;
  border-radius: 12px;
}
.answer-actions {
  display: flex;
  align-items: center;
  margin-top: 24px;
}
.answer-analysis {
  margin-top: 24px;
  padding: 16px;
  border-radius: 12px;
  background: #f5f7fb;
  font-size: 14px;
  line-height: 1.85;
}
.analysis-label {
  display: block;
  color: #4e5c72;
  font-size: 14px;
  font-weight: 600;
  margin-bottom: 6px;
}
.iknow {
  margin: 20px auto 0;
  min-height: 46px;
  line-height: 46px;
  text-align: center;
  border-radius: 12px;
  background: #2864eb;
  color: #fff;
  font-size: 15px;
  font-weight: 600;
}
.pop-tip {
  position: fixed;
  display: flex;
  flex-direction: column;
  z-index: 10002;
  top: 50%;
  left: 50%;
  width: 90%;
  max-width: 440px;
  max-height: 82vh;
  overflow: hidden;
  transform: translate(-50%, -50%);
  padding: 0;
  border-radius: 20px;
  background: #fff;
  box-shadow: 0 24px 80px rgba(20, 38, 70, 0.18);
}
.pop-tip-title {
  margin: 0;
  padding-right: 44px;
  font-size: 20px;
  line-height: 1.5;
  font-weight: 700;
  text-align: left;
}
.dialog-header {
  position: relative;
  flex-shrink: 0;
  padding: 24px 24px 16px;
  background: #fff;
}
.dialog-intro {
  margin-top: 8px;
  color: #68758a;
  font-size: 13px;
  line-height: 1.7;
}
.dialog-close {
  position: absolute;
  top: 16px;
  right: 16px;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40px !important;
  height: 40px;
  padding: 0;
  margin: 0;
  border-radius: 12px;
  background: #f2f5fa;
}
.close-mark {
  position: relative;
  width: 18px;
  height: 18px;
}
.close-mark::before,
.close-mark::after {
  content: "";
  position: absolute;
  top: 8px;
  left: 1px;
  width: 16px;
  height: 2px;
  border-radius: 1px;
  background: #68758a;
  transform: rotate(45deg);
}
.close-mark::after {
  transform: rotate(-45deg);
}
.dialog-scroll {
  height: auto;
  max-height: calc(82vh - 190px);
  min-height: 0;
  flex: 0 1 auto;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
}
.dialog-scroll-short {
  height: auto;
  max-height: calc(82vh - 190px);
}
.dialog-body {
  padding: 0 24px 8px;
}
.dialog-footer {
  flex-shrink: 0;
  padding: 16px 24px 24px;
  border-top: 1px solid #f0f3f8;
  background: #fff;
}
.dialog-footer .iknow {
  margin: 0;
}
.dialog-actions {
  display: flex;
}
.dialog-action {
  flex: 1;
  min-width: 0;
  min-height: 48px;
  line-height: 48px;
  margin: 0;
  padding: 0 12px;
  border-radius: 12px;
  background: #2864eb;
  color: #fff;
  font-size: 15px;
  font-weight: 600;
  text-align: center;
}
.dialog-action-secondary {
  margin-right: 12px;
  background: #eef2f8;
  color: #4e5c72;
}
.skip {
  display: inline-block;
  padding: 7px 10px;
  min-height: 36px;
  border-radius: 10px;
  background: #eaf0fc;
  color: #2056ce;
  font-size: 13px;
  text-align: center;
}
.feedback-action {
  background: #fff0f0;
  color: #ad3542;
}
.top-text {
  min-width: 64px;
  text-align: center;
}
.common-gray {
  font-size: 13px;
  color: #68758a;
}
.underline-class {
  text-decoration: underline;
}
.board {
  position: fixed;
  z-index: 10001;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(20, 32, 53, 0.48);
}
.list-footer {
  text-align: center;
  color: #68758a;
  font-size: 14px;
  padding: 24px 12px;
}

/* Native text uses a different default box model from the browser prototype. */
.question-toolbar .skip {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  flex-shrink: 0;
  height: 36px;
  min-height: 36px;
  padding: 0 12px;
  line-height: 1;
  white-space: nowrap;
}
.question-toolbar .toolbar-placeholder {
  background: transparent;
}
.question-share-row {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  margin-top: 18px;
}
.question-share-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 40px;
  margin: 0;
  padding: 8px 14px;
  border-radius: 10px;
  background: #edf3ff;
  color: #2056ce;
  font-size: 13px;
}
.question-share-icon {
  width: 16px;
  height: 16px;
  margin-right: 6px;
}
.question-footer-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-top: 18px;
}
.question-footer-actions .question-feedback-button,
.question-footer-actions .question-share-button {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 1 auto;
  box-sizing: border-box;
  width: auto;
  min-width: 0;
  min-height: 40px;
  margin: 0;
  padding: 8px 12px;
  border: 0;
  font-size: 13px;
  line-height: 1.7;
  white-space: nowrap;
}
.question-footer-actions .question-feedback-button {
  flex-shrink: 0;
  background: transparent;
  color: #68758a;
}
.question-footer-actions button::after {
  border: 0;
}
.question-footer-icon {
  width: 16px;
  height: 16px;
  margin-right: 6px;
}
.question-footer-actions .question-feedback-button[disabled] {
  color: #9aa5b5;
}
.question-feedback-button[disabled] .question-footer-icon {
  opacity: 0.45;
}
.illustrated-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24px 16px;
  text-align: center;
}
.empty-illustration {
  width: 144px;
  height: 108px;
}
.empty-title {
  color: #35435a;
  font-size: 16px;
  font-weight: 600;
  margin-top: 10px;
}
.empty-description {
  color: #68758a;
  font-size: 13px;
  line-height: 1.8;
  margin-top: 6px;
}

.question-share-button[disabled] {
  background: #edf0f5;
  color: #8793a5;
}

/* Shared reading and action hierarchy for all answering modes. */
.quiz-page {
  box-sizing: border-box;
  max-width: 680px;
  margin: 0 auto;
  padding: 8px 20px calc(156px + env(safe-area-inset-bottom));
}
.quiz-header {
  margin-bottom: 20px;
}
.quiz-header__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  min-height: 40px;
}
.quiz-mode {
  flex-shrink: 0;
  padding: 8px 12px;
  border-radius: 10px;
  background: #eaf0fe;
  color: #2056ce;
  font-size: 13px;
  font-weight: 600;
  line-height: 1.4;
}
.quiz-score {
  display: flex;
  align-items: baseline;
  justify-content: center;
  flex: 1;
  min-width: 0;
  color: #2056ce;
}
.quiz-score__number {
  font-size: 25px;
  font-weight: 700;
  line-height: 1.2;
}
.quiz-score__unit {
  margin-left: 3px;
  font-size: 13px;
}
.quiz-clock {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  gap: 6px;
  color: #52617a;
  font-size: 13px;
  font-variant-numeric: tabular-nums;
  white-space: nowrap;
}
.quiz-clock__icon {
  box-sizing: border-box;
  position: relative;
  width: 14px;
  height: 14px;
  border: 1.5px solid currentColor;
  border-radius: 50%;
}
.quiz-clock__icon::after {
  content: "";
  position: absolute;
  left: 5px;
  top: 2px;
  width: 3px;
  height: 4px;
  border-left: 1.5px solid currentColor;
  border-bottom: 1.5px solid currentColor;
}
.quiz-clock-urgent {
  color: #ad3542;
}
.quiz-header__detail {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 36px;
  margin-top: 5px;
}
.quiz-position {
  color: #52617a;
  font-size: 13px;
}
.quiz-header__hint {
  color: #68758a;
  font-size: 12px;
}
.quiz-header__detail .quiz-skip {
  display: flex;
  align-items: center;
  gap: 6px;
  width: auto;
  min-width: 0;
  min-height: 36px;
  margin: 0 -6px 0 0;
  padding: 6px;
  background: transparent;
  color: #68758a;
  font-size: 13px;
  line-height: 1.5;
}
.quiz-skip::after {
  border: 0;
}
.quiz-skip__number {
  color: #2056ce;
  font-weight: 600;
}
.quiz-progress {
  height: 3px;
  overflow: hidden;
  border-radius: 3px;
  background: #e4eaf5;
}
.quiz-progress__fill {
  height: 100%;
  border-radius: 3px;
  background: #2864eb;
  transition: width 180ms ease;
}
.quiz-page .quiz-card {
  margin: 0;
  padding: 23px 20px;
  border: 1px solid #edf1f7;
  border-radius: 22px;
  background: #fff;
  box-shadow: 0 5px 22px rgba(31, 54, 100, 0.025);
}
.quiz-page .quiz-card .question_body {
  color: #202b40;
  font-size: 19px;
  font-weight: 600;
  line-height: 1.75;
}
.quiz-section-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 22px 2px 12px;
  color: #52617a;
  font-size: 13px;
  font-weight: 500;
}
.quiz-section-hint {
  color: #68758a;
  font-size: 12px;
  font-weight: 400;
}
.quiz-options .quiz-option {
  display: flex;
  align-items: center;
  gap: 12px;
  box-sizing: border-box;
  min-height: 64px;
  margin: 0 0 12px;
  padding: 14px;
  border: 1px solid #e4eaf3;
  border-radius: 16px;
  background: #fff;
  color: #35435a;
  font-size: 16px;
  font-weight: 400;
  line-height: 1.65;
  transition:
    border-color 140ms ease,
    background-color 140ms ease;
}
.quiz-option__letter {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 30px;
  width: 30px;
  height: 30px;
  border-radius: 9px;
  background: #f1f4f9;
  color: #62728d;
  font-size: 14px;
  font-weight: 600;
}
.quiz-option__content {
  flex: 1;
  min-width: 0;
  word-break: break-word;
}
.quiz-option__content .image-option {
  width: 100%;
  max-width: 220px;
  margin: 0;
}
.quiz-option__indicator {
  position: relative;
  flex: 0 0 18px;
  box-sizing: border-box;
  width: 18px;
  height: 18px;
  border: 1.5px solid #d6deeb;
  border-radius: 50%;
}
.quiz-option.option_selected {
  border-color: #2864eb;
  background: #edf3ff;
  color: #2056ce;
  font-weight: 500;
}
.quiz-option.option_selected .quiz-option__letter {
  background: #2864eb;
  color: #fff;
}
.quiz-option__indicator-selected {
  border-color: #2864eb;
}
.quiz-option__indicator-selected::after {
  content: "";
  position: absolute;
  left: 4px;
  top: 4px;
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #2864eb;
}
.quiz-option.answer_result1 .quiz-option__letter,
.quiz-option.answer_result1 .quiz-option__indicator {
  border-color: #258359;
  background: #258359;
  color: #fff;
}
.quiz-option.answer_result1 .quiz-option__indicator::after {
  content: "";
  position: absolute;
  left: 5px;
  top: 2px;
  width: 4px;
  height: 8px;
  border: solid #fff;
  border-width: 0 1.5px 1.5px 0;
  border-radius: 0;
  background: transparent;
  transform: rotate(45deg);
}
.quiz-option.answer_result0 .quiz-option__letter,
.quiz-option.answer_result0 .quiz-option__indicator {
  border-color: #b64b55;
  background: #b64b55;
  color: #fff;
}
.quiz-option.answer_result0 .quiz-option__indicator::before,
.quiz-option.answer_result0 .quiz-option__indicator::after {
  content: "";
  position: absolute;
  left: 3px;
  top: 7px;
  width: 9px;
  height: 1.5px;
  border: 0;
  border-radius: 0;
  background: #fff;
  transform: rotate(45deg);
}
.quiz-option.answer_result0 .quiz-option__indicator::before {
  transform: rotate(-45deg);
}
.quiz-option-pressed {
  opacity: 0.75;
}
.quiz-page .quiz-analysis,
.quiz-page .quiz-result-card {
  margin-top: 18px;
  padding: 20px;
  border: 0;
  border-radius: 20px;
  background: #fff;
}
.quiz-analysis .analysis-label {
  display: block;
  margin-bottom: 8px;
  font-size: 14px;
}
.quiz-result-title {
  color: #202b40;
  font-size: 18px;
  font-weight: 600;
}
.quiz-result-description {
  display: block;
  margin-top: 8px;
  color: #68758a;
  font-size: 14px;
  line-height: 1.7;
}
.quiz-footer {
  position: fixed;
  z-index: 20;
  left: 0;
  right: 0;
  bottom: 0;
  box-sizing: border-box;
  padding: 12px 20px calc(8px + env(safe-area-inset-bottom));
  border-top: 1px solid #e7edf5;
  background: #fff;
  box-shadow: 0 -8px 28px rgba(31, 54, 100, 0.035);
}
.quiz-footer__inner {
  max-width: 640px;
  margin: 0 auto;
}
.quiz-footer__primary-row {
  display: flex;
  align-items: stretch;
  gap: 10px;
}
.quiz-footer .quiz-submit,
.quiz-footer .quiz-secondary,
.quiz-footer .quiz-nav-button {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: auto;
  min-width: 0;
  min-height: 52px;
  margin: 0;
  padding: 12px 16px;
  border: 0;
  border-radius: 14px;
  font-size: 16px;
  font-weight: 600;
  line-height: 1.5;
}
.quiz-footer .quiz-submit {
  flex: 1;
  width: 100%;
  background: #2864eb;
  color: #fff;
}
.quiz-footer .quiz-footer__primary-row .quiz-submit {
  width: auto;
}
.quiz-footer .quiz-secondary {
  flex: 1;
  background: #edf3ff;
  color: #2056ce;
}
.quiz-footer .quiz-nav-button {
  flex: 0 0 64px;
  width: 64px;
  min-width: 64px;
  padding: 0;
  border: 1px solid #d9e4f5;
  border-radius: 12px;
  background: #f0f5ff;
  color: #48618a;
  font-size: 14px;
  font-weight: 500;
}
.quiz-footer .quiz-submit[disabled] {
  background: #dfe8fb;
  color: #7f9ac8;
}
.quiz-footer .quiz-nav-button[disabled] {
  border-color: #edf1f6;
  background: #f7f9fc;
  color: #b9c3d2;
}
.quiz-footer button::after {
  border: 0;
}
.quiz-footer .question-footer-actions {
  margin-top: 5px;
}
.quiz-footer .question-feedback-button,
.quiz-footer .question-share-button {
  padding: 8px 0;
  background: transparent;
  color: #68758a;
}
.quiz-button-spinner {
  box-sizing: border-box;
  width: 16px;
  height: 16px;
  margin-right: 8px;
  border: 2px solid currentColor;
  border-right-color: transparent;
  border-radius: 50%;
  animation: quiz-spin 750ms linear infinite;
}
@keyframes quiz-spin {
  to {
    transform: rotate(360deg);
  }
}
@media (prefers-reduced-motion: reduce) {
  .quiz-option,
  .quiz-progress__fill {
    transition: none;
  }
  .quiz-button-spinner {
    animation: none;
  }
}
.quiz-header__correct {
  color: #52617a;
  font-size: 13px;
  white-space: nowrap;
}
.quiz-header__top .quiz-position {
  min-width: 0;
  text-align: center;
  white-space: nowrap;
}
.single-page.quiz-page {
  padding-bottom: calc(156px + env(safe-area-inset-bottom));
}
