@import "./styles/motion.wxss";

page {
  background: #f5f7fb;
  color: #202b40;
  font-size: 15px;
  line-height: 1.6;
  font-family:
    -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue",
    "Microsoft Yahei", sans-serif;
  -webkit-tap-highlight-color: transparent;
}
view,
scroll-view,
button,
input,
textarea {
  box-sizing: border-box;
}
button::after {
  border: none;
}
button {
  font-family: inherit;
}
.container {
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}
.page-shell {
  padding: 24px 20px 32px;
}
.page-title {
  font-size: 26px;
  line-height: 1.3;
  font-weight: 800;
  letter-spacing: -0.5px;
}
.page-subtitle {
  margin-top: 8px;
  color: #68758a;
  font-size: 14px;
}
.section-title {
  font-size: 18px;
  font-weight: 700;
}
.section-caption {
  color: #68758a;
  font-size: 12px;
}
.surface {
  background: #fff;
  border-radius: 20px;
  box-shadow: 0 4px 24px rgba(31, 54, 100, 0.035);
}
.primary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 54px;
  border-radius: 16px;
  background: #2864eb;
  color: #fff;
  font-size: 17px;
  font-weight: 700;
  box-shadow: 0 6px 16px rgba(40, 100, 235, 0.16);
}
.primary-button:active {
  background: #2056ce;
}
.blink_me {
  animation: blinker 3s linear infinite;
}
@keyframes blinker {
  50% {
    opacity: 0;
  }
}
.rule-item {
  padding: 6px 0;
  line-height: 1.85;
  font-size: 14px;
  color: #4e5c72;
}
.rule-item-indent {
  padding-left: 20px;
}
.hi-num {
  color: #2056ce;
  font-weight: 700;
}
.question-container {
  padding: 24px 20px 36px;
}
.question-toolbar {
  display: flex;
  align-items: center;
  min-height: 44px;
  margin-bottom: 20px;
}
.question-common {
  padding: 22px 18px;
  border-radius: 24px;
  background: #fff;
  box-shadow: 0 4px 24px rgba(31, 54, 100, 0.035);
}
.question-eyebrow {
  color: #2056ce;
  font-size: 13px;
  font-weight: 600;
  margin-bottom: 12px;
}
.question_body {
  font-size: 17px;
  line-height: 1.85;
  font-weight: 600;
  word-break: break-word;
}
.option-common {
  display: flex;
  align-items: center;
  min-height: 56px;
  margin-top: 12px;
  padding: 12px 16px;
  border: 1px solid #e3e9f2;
  border-radius: 14px;
  background: #f8faff;
  color: #35435a;
  font-size: 16px;
  line-height: 1.7;
  word-break: break-word;
}
.option_selected {
  background: #edf3ff;
  border-color: #2864eb;
  color: #2056ce;
  font-weight: 600;
}
.answer_result0 {
  background: #fff0f0 !important;
  border-color: #eaa7aa !important;
  color: #ad3542 !important;
  font-weight: 600;
}
.answer_result1 {
  background: #eaf8f1 !important;
  border-color: #84c7a6 !important;
  color: #19764d !important;
  font-weight: 600;
}
.image-option {
  width: 166px;
  max-width: 85%;
  border-radius: 8px;
  margin-left: 4px;
}
.image-question {
  display: block;
  width: 100%;
  margin: 16px auto;
  border-radius: 12px;
}
.video-option {
  width: 100%;
  height: 180px;
  margin: 16px 0;
  border-radius: 12px;
}
.answer-actions {
  display: flex;
  align-items: center;
  margin-top: 24px;
}
.answer-analysis {
  margin-top: 24px;
  padding: 16px;
  border-radius: 12px;
  background: #f5f7fb;
  font-size: 14px;
  line-height: 1.85;
}
.analysis-label {
  display: block;
  color: #4e5c72;
  font-size: 14px;
  font-weight: 600;
  margin-bottom: 6px;
}
.iknow {
  margin: 20px auto 0;
  min-height: 46px;
  line-height: 46px;
  text-align: center;
  border-radius: 12px;
  background: #2864eb;
  color: #fff;
  font-size: 15px;
  font-weight: 600;
}
.pop-tip {
  position: fixed;
  display: flex;
  flex-direction: column;
  z-index: 10002;
  top: 50%;
  left: 50%;
  width: 90%;
  max-width: 440px;
  max-height: 82vh;
  overflow: hidden;
  transform: translate(-50%, -50%);
  padding: 0;
  border-radius: 20px;
  background: #fff;
  box-shadow: 0 24px 80px rgba(20, 38, 70, 0.18);
}
.pop-tip-title {
  margin: 0;
  padding-right: 44px;
  font-size: 20px;
  line-height: 1.5;
  font-weight: 700;
  text-align: left;
}
.dialog-header { position: relative; flex-shrink: 0; padding: 24px 24px 16px; background: #fff; }
.dialog-intro { margin-top: 8px; color: #68758a; font-size: 13px; line-height: 1.7; }
.dialog-close { position: absolute; top: 16px; right: 16px; display: flex; align-items: center; justify-content: center; width: 40px !important; height: 40px; padding: 0; margin: 0; border-radius: 12px; background: #f2f5fa; }
.close-mark { position: relative; width: 18px; height: 18px; }
.close-mark::before, .close-mark::after { content: ""; position: absolute; top: 8px; left: 1px; width: 16px; height: 2px; border-radius: 1px; background: #68758a; transform: rotate(45deg); }
.close-mark::after { transform: rotate(-45deg); }
.dialog-scroll { height: auto; max-height: calc(82vh - 190px); min-height: 0; flex: 0 1 auto; overflow-y: auto; -webkit-overflow-scrolling: touch; }
.dialog-scroll-short { height: auto; max-height: calc(82vh - 190px); }
.dialog-body { padding: 0 24px 8px; }
.dialog-footer { flex-shrink: 0; padding: 16px 24px 24px; border-top: 1px solid #f0f3f8; background: #fff; }
.dialog-footer .iknow { margin: 0; }
.dialog-actions { display: flex; }
.dialog-action { flex: 1; min-width: 0; min-height: 48px; line-height: 48px; margin: 0; padding: 0 12px; border-radius: 12px; background: #2864eb; color: #fff; font-size: 15px; font-weight: 600; text-align: center; }
.dialog-action-secondary { margin-right: 12px; background: #eef2f8; color: #4e5c72; }
.skip {
  display: inline-block;
  padding: 7px 10px;
  min-height: 36px;
  border-radius: 10px;
  background: #eaf0fc;
  color: #2056ce;
  font-size: 13px;
  text-align: center;
}
.feedback-action {
  background: #fff0f0;
  color: #ad3542;
}
.top-text {
  min-width: 64px;
  text-align: center;
}
.common-gray {
  font-size: 13px;
  color: #68758a;
}
.underline-class {
  text-decoration: underline;
}
.board {
  position: fixed;
  z-index: 10001;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(20, 32, 53, 0.48);
}
.list-footer {
  text-align: center;
  color: #68758a;
  font-size: 14px;
  padding: 24px 12px;
}

/* Native text uses a different default box model from the browser prototype. */
.question-toolbar .skip { display: flex; align-items: center; justify-content: center; box-sizing: border-box; flex-shrink: 0; height: 36px; min-height: 36px; padding: 0 12px; line-height: 1; white-space: nowrap; }
.question-toolbar .toolbar-placeholder { background: transparent; }
.question-share-row { display: flex; align-items: center; justify-content: flex-end; margin-top: 18px; }
.question-share-button { display: flex; align-items: center; justify-content: center; min-height: 40px; margin: 0; padding: 8px 14px; border-radius: 10px; background: #edf3ff; color: #2056ce; font-size: 13px; }
.question-share-icon { width: 16px; height: 16px; margin-right: 6px; }
.illustrated-empty { display: flex; flex-direction: column; align-items: center; padding: 24px 16px; text-align: center; }
.empty-illustration { width: 144px; height: 108px; }
.empty-title { color: #35435a; font-size: 16px; font-weight: 600; margin-top: 10px; }
.empty-description { color: #68758a; font-size: 13px; line-height: 1.8; margin-top: 6px; }

.question-share-button[disabled] { background: #edf0f5; color: #8793a5; }
