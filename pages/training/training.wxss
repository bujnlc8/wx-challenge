.count_down_class {
  color: #68758a;
  font-size: 14px;
}
.count-down-stop {
  color: #68758a;
  font-size: 22px;
  font-weight: 700;
  margin-left: 4px;
}
.count-down {
  color: #2056ce;
  font-size: 22px;
  font-weight: 700;
  margin-left: 4px;
}
.sub_button {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: auto;
  width: 50%;
  min-height: 50px;
  border: 1px solid #d4dff5;
  border-radius: 14px;
  background: #edf3ff;
  color: #2056ce;
  font-size: 16px;
  font-weight: 600;
}
.sub_button_active {
  background: #2864eb;
  border-color: #2864eb;
  color: #fff;
  box-shadow: 0 4px 12px rgba(40, 100, 235, 0.16);
}
.question-pagination {
  display: flex;
  margin-top: 16px;
}
.up-question,
.next-question {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  min-height: 46px;
  border: 1px solid #e3e9f2;
  border-radius: 12px;
  color: #4e5c72;
  font-size: 14px;
}
.next-question {
  margin-left: 12px;
}

.quiz-practice-line {
  gap: 8px;
}
.quiz-practice-stats {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  gap: 5px;
  color: #52617a;
  font-size: 12px;
  white-space: nowrap;
}
.quiz-stat-separator {
  color: #8a96a8;
}
.quiz-practice-line .quiz-position,
.quiz-practice-line .quiz-clock {
  font-size: 12px;
}
@media (max-width: 360px) {
  .quiz-practice-line {
    gap: 6px;
  }
  .quiz-practice-line .quiz-mode {
    padding-left: 8px;
    padding-right: 8px;
    font-size: 12px;
  }
  .quiz-practice-line .quiz-clock {
    gap: 4px;
  }
  .quiz-practice-line .quiz-clock__icon {
    display: none;
  }
}

.quiz-practice-line .quiz-time-value {
  display: inline-block;
  min-width: 34px;
  text-align: right;
  font-variant-numeric: tabular-nums;
}
