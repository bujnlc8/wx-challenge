.count_down_class {
  color: #68758a;
  font-size: 14px;
}
.count-down-stop {
  color: #68758a;
  font-size: 22px;
  font-weight: 700;
  margin-left: 4px;
}
.count-down {
  color: #2056ce;
  font-size: 22px;
  font-weight: 700;
  margin-left: 4px;
}
.sub_button {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: auto;
  width: 50%;
  min-height: 50px;
  border: 1px solid #d4dff5;
  border-radius: 14px;
  background: #edf3ff;
  color: #2056ce;
  font-size: 16px;
  font-weight: 600;
}
.sub_button_active {
  background: #2864eb;
  border-color: #2864eb;
  color: #fff;
  box-shadow: 0 4px 12px rgba(40, 100, 235, 0.16);
}
.question-pagination {
  display: flex;
  margin-top: 16px;
}
.up-question,
.next-question {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  min-height: 46px;
  border: 1px solid #e3e9f2;
  border-radius: 12px;
  color: #4e5c72;
  font-size: 14px;
}
.next-question {
  margin-left: 12px;
}
