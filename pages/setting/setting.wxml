<page-meta page-style="{{(modal_locked) ? 'overflow: hidden;' : ''}}" />
<view class="page-shell">
  <view class="page-title">按你的习惯来</view><view class="page-subtitle">调整作答体验，找到舒服的节奏</view>
  <view class="settings-group surface">
    <view class="menu" bindtap="openQuestionCountSheet" hover-class="button-pressed" hover-start-time="20" hover-stay-time="80"><view class="setting-info"><view class="setting-title">每次挑战题数</view><view class="setting-description">下一次普通挑战生效，可设置 1–100 题</view></view><text class="setting-value">{{challenge_question_count}}题</text><image src="../../images/right_arrow.png" class="setting-arrow" /></view>
    <view class="menu" bindtap="operateShowCorrectAnswer" hover-class="button-pressed" hover-start-time="20" hover-stay-time="80"><view class="setting-info"><view class="setting-title">显示正确答案</view><view class="setting-description">作答后查看正确选项</view></view><switch color="#2864eb" checked="{{show_correct_answer}}"></switch></view>
    <view class="menu" bindtap="operateShowAnalysis" hover-class="button-pressed" hover-start-time="20" hover-stay-time="80"><view class="setting-info"><view class="setting-title">显示答案解析</view><view class="setting-description">了解答案背后的知识</view></view><switch color="#2864eb" checked="{{show_analysis}}"></switch></view>
    <view class="menu" bindtap="operateSound" hover-class="button-pressed" hover-start-time="20" hover-stay-time="80"><view class="setting-info"><view class="setting-title">提示音效</view><view class="setting-description">按自己的喜好选择答题声音</view></view><switch color="#2864eb" checked="{{sound_close == 0}}"></switch></view>
  </view>
</view>

<view wx:if="{{question_count_sheet_visible}}" class="question-count-mask" catchtap="catchtouchmove" catchtouchmove="catchtouchmove"></view>
<view wx:if="{{question_count_sheet_visible}}" class="question-count-sheet" catchtap="catchtouchmove">
  <view class="dialog-header">
    <view class="pop-tip-title">每次挑战题数</view>
    <button class="dialog-close" bindtap="cancelQuestionCountSheet" aria-label="关闭题数设置" hover-class="button-pressed"><view class="close-mark"></view></button>
    <view class="dialog-intro">选择适合自己的节奏，下一次普通挑战生效</view>
  </view>
  <view class="question-count-scroll">
    <view class="question-count-body">
      <view class="count-presets">
        <button wx:for="{{question_count_options}}" wx:key="*this" class="count-preset {{question_count_draft == item ? 'count-preset-selected' : ''}}" data-count="{{item}}" bindtap="chooseQuestionCount" aria-role="radio" aria-checked="{{question_count_draft == item}}" hover-class="button-pressed">{{item}}题</button>
      </view>
      <view class="count-custom-label">自定义题数</view>
      <view class="count-stepper">
        <button class="count-step" data-step="-1" bindtap="stepQuestionCount" disabled="{{question_count_draft == 1}}" aria-label="减少一题" hover-class="button-pressed">−</button>
        <input class="count-input" type="number" maxlength="4" value="{{question_count_draft}}" bindinput="inputQuestionCount" confirm-type="done" bindconfirm="confirmQuestionCountSheet" aria-label="题数，1至100的整数" />
        <text class="count-unit">题</text>
        <button class="count-step" data-step="1" bindtap="stepQuestionCount" disabled="{{question_count_draft == 100}}" aria-label="增加一题" hover-class="button-pressed">＋</button>
      </view>
      <view class="count-hint">可输入 1–100 的任意整数</view>
      <view wx:if="{{question_count_error}}" class="count-error">{{question_count_error}}</view>
    </view>
  </view>
  <view class="dialog-footer dialog-actions question-count-actions"><button class="dialog-action dialog-action-secondary" bindtap="cancelQuestionCountSheet" hover-class="button-pressed">取消</button><button class="dialog-action" bindtap="confirmQuestionCountSheet" hover-class="button-pressed">确认</button></view>
</view>

<ui-feedback state="{{ui_feedback}}" />
