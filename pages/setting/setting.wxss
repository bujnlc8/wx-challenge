.settings-group {
  margin-top: 24px;
  padding: 4px 20px;
}
.menu {
  display: flex;
  align-items: center;
  min-height: 76px;
  border-bottom: 1px solid #edf1f6;
}
.menu:last-child {
  border-bottom: none;
}
.setting-info {
  flex: 1;
  padding: 14px 12px 14px 0;
}
.setting-title {
  font-size: 15px;
  font-weight: 600;
}
.setting-description {
  color: #68758a;
  font-size: 12px;
  margin-top: 4px;
}
