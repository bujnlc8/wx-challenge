<page-meta page-style="{{modal_locked ? 'overflow: hidden;' : ''}}" />
<view class="page-shell help-page">
  <view class="page-title">使用帮助</view>
  <view class="page-subtitle">常见问题，点开查看</view>
  <view class="help-list surface">
    <view wx:for="{{sections}}" wx:key="id" class="help-section">
      <view class="help-question" data-id="{{item.id}}" bindtap="toggleSection" aria-role="button" aria-expanded="{{active_section === item.id}}" hover-class="help-question-pressed">
        <text class="help-heading">{{item.title}}</text>
        <image class="help-arrow {{active_section === item.id ? 'help-arrow-open' : ''}}" src="/images/right_arrow.png" mode="aspectFit" />
      </view>
      <view wx:if="{{active_section === item.id}}" class="help-answer">
        <text wx:for="{{item.paragraphs}}" wx:for-item="paragraph" wx:key="*this" class="help-copy">{{paragraph}}</text>
      </view>
    </view>
  </view>
</view>
<ui-feedback state="{{ui_feedback}}" />
