.help-page {
  max-width: 680px;
  margin: 0 auto;
}
.help-page > .page-subtitle {
  margin-bottom: 22px;
}
.help-list {
  padding: 0 20px;
}
.help-section + .help-section {
  border-top: 1px solid #edf1f6;
}
.help-question {
  display: flex;
  align-items: center;
  min-height: 64px;
  gap: 12px;
  padding: 16px 0;
  box-sizing: border-box;
}
.help-question-pressed {
  opacity: 0.65;
}
.help-heading {
  flex: 1;
  min-width: 0;
  color: #202b40;
  font-size: 15px;
  font-weight: 500;
  line-height: 1.65;
}
.help-arrow {
  flex: 0 0 16px;
  width: 16px;
  height: 16px;
  transition: transform 180ms ease;
}
.help-arrow-open {
  transform: rotate(90deg);
}
.help-answer {
  padding: 0 0 20px;
}
.help-copy {
  display: block;
  color: #68758a;
  font-size: 14px;
  line-height: 1.85;
}
.help-copy + .help-copy {
  margin-top: 10px;
}
@media (prefers-reduced-motion: reduce) {
  .help-arrow {
    transition: none;
  }
}
