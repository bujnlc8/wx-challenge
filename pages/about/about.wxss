.about-page {
  min-height: 100vh;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 64px 24px 40px;
}
.about-brand {
  width: 100%;
  text-align: center;
  margin-top: 4vh;
}
.about-logo {
  display: block;
  width: 96px;
  height: 96px;
  border-radius: 24px;
  margin: 0 auto 24px;
}
.about-name {
  color: #202b40;
  font-size: 24px;
  font-weight: 750;
  line-height: 1.5;
}
.about-slogan {
  margin-top: 10px;
  color: #68758a;
  font-size: 14px;
}
.about-version {
  margin-top: 12px;
  color: #8793a6;
  font-size: 12px;
}
.about-share {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-sizing: border-box;
  width: 100%;
  max-width: 280px;
  min-height: 52px;
  padding: 12px 20px;
  margin: 40px auto 0;
  border-radius: 14px;
  background: #eaf1ff;
  color: #2056ce;
  font-size: 16px;
  font-weight: 600;
}
.about-share-icon {
  width: 20px;
  height: 20px;
  margin-right: 10px;
}

.about-logout {
  flex-shrink: 0;
  min-width: 140px;
  min-height: 44px;
  line-height: 44px;
  width: auto;
  padding: 0 12px;
  margin: auto auto 0;
  background: transparent;
  color: #8793a6;
  font-size: 13px;
}
