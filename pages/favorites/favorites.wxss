.favorites-page {
  padding: 20px 16px 28px;
}
.favorites-summary {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 6px 12px;
  margin: 0 2px 18px;
  color: #68758a;
  font-size: 13px;
}
.favorites-summary__count {
  display: flex;
  align-items: baseline;
  gap: 7px;
}
.favorites-summary__number {
  color: #202b40;
  font-size: 28px;
  font-weight: 700;
  line-height: 1.3;
  font-variant-numeric: tabular-nums;
}
.favorites-summary__note {
  color: #8793a6;
  font-size: 12px;
}
.favorite-card {
  margin-bottom: 16px;
  padding: 18px 16px 16px;
  border: 1px solid #e7edf7;
  border-radius: 20px;
  box-shadow: 0 4px 18px rgba(35, 62, 110, 0.035);
}
.favorite-question-content {
  color: #202b40;
  font-size: 17px;
  font-weight: 500;
  line-height: 1.8;
  word-break: break-word;
  white-space: pre-wrap;
}
.favorite-media {
  overflow: hidden;
  margin-top: 14px;
  border: 1px solid #e8eef8;
  border-radius: 12px;
  background: #f5f8fd;
}
.favorite-question-image,
.favorite-question-video {
  display: block;
  width: 100%;
  height: 200px;
}
.favorite-card-footer {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 10px 12px;
  margin: 18px -16px -16px;
  border-top: 1px solid #edf1f6;
  border-radius: 0 0 20px 20px;
  background: #fbfcff;
}
.favorite-created-at {
  flex: 1;
  min-width: 70px;
  color: #8793a6;
  font-size: 12px;
  line-height: 18px;
  white-space: normal;
  word-break: normal;
  overflow-wrap: normal;
}
.favorite-footer-actions {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  gap: 4px;
}
.favorite-footer-actions button {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: auto;
  min-width: 0;
  margin: 0;
  padding: 0;
  border: 0;
  font-size: 12px;
  line-height: 18px;
  white-space: nowrap;
}
.favorite-footer-actions button::after,
.favorites-retry-more::after {
  border: 0;
}
.favorite-footer-actions .favorite-remove-star {
  width: 44px;
  min-width: 44px;
  height: 44px;
  background: transparent;
}
.favorite-remove-star image,
.favorite-share image {
  width: 16px;
  height: 16px;
}
.favorite-footer-actions .favorite-share {
  width: 52px;
  height: 44px;
  background: transparent;
  color: #48618d;
}
.favorite-share image {
  margin-right: 4px;
}
.favorite-footer-actions .favorite-start {
  min-height: 36px;
  padding: 8px 10px;
  border-radius: 8px;
  background: #2864eb;
  color: #ffffff;
  font-size: 13px;
  line-height: 20px;
}
.favorite-footer-actions button[disabled] {
  opacity: 0.5;
}
.favorites-pagination {
  padding: 8px 0 18px;
  text-align: center;
  color: #8793a6;
  font-size: 12px;
}
.favorites-retry-more {
  width: auto;
  padding: 8px;
  background: transparent;
  color: #2056ce;
  font-size: 13px;
}
.favorites-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 70px 16px 40px;
  text-align: center;
}
.favorites-state image {
  width: 180px;
  height: 140px;
}
.favorites-state-title {
  margin-top: 24px;
  color: #202b40;
  font-size: 18px;
  font-weight: 600;
}
.favorites-state-copy {
  margin: 12px 0 24px;
  color: #68758a;
  font-size: 14px;
  line-height: 1.8;
}
.favorites-state .primary-button {
  width: 100%;
}
.favorites-spinner {
  width: 24px;
  height: 24px;
  border: 3px solid #dce7fd;
  border-top-color: #2864eb;
  border-radius: 50%;
  animation: favorite-spin 0.8s linear infinite;
}
@keyframes favorite-spin {
  to {
    transform: rotate(360deg);
  }
}
