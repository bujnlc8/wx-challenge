<page-meta page-style="{{(modal_locked) ? 'overflow: hidden;' : ''}}" />
<wxs src="../../utils/util.wxs" module="tools" />
<view wx:if="{{logined}}" class="question-container">
	<view class="question-toolbar">
		<text class="skip top-text feedback-action" bindtap="doFeedback" wx:if="{{answer_result != -1 && answer_result != -2}}">反馈</text>
		<text class="skip top-text" wx:else="">{{correct_question_num}} | {{continue_correct_num}}</text>
		<text class="current_score">{{current_score}}分</text>
		<text class="skip" bindtap="hideQuestion" data-t="1" style="cursor: pointer;">跳过x{{last_skip_chance}}</text>
	</view>
	<view class="question-common" bindlongpress="hideQuestion">
    <view class="question-eyebrow">挑战模式</view>
		<view class="question_body" wx:if="{{ tools.indexOf(current_question, '/>') || tools.indexOf(current_question, '</')}}">第{{total_index}}题：<rich-text space="true" nodes="{{current_question}}"></rich-text>
		</view>
		<view class="question_body" wx:if="{{ !(tools.indexOf(current_question, '/>') || tools.indexOf(current_question, '</')) }}">第{{total_index}}题：<text>{{current_question}}</text>
		</view>
		<image wx:if="{{question_image && !is_video}}" src="{{question_image}}" class="image-question" mode="widthFix" bindtap="previewImg" data-image_src="{{question_image}}" style="cursor: pointer;" />
		<video wx:if="{{question_image && is_video }}" src="{{question_image}}" class="video-option" autoplay="true" enable-play-gesture="true" picture-in-picture-show-progress="true" loop="true"></video>
		<view wx:if="{{option_type == 0}}">
			<view wx:if="{{option_a}}" data-i="1" class="option-common {{selected_option == 1?'option_selected': ''}} {{ selected_option == 1 && answer_result != -1 && answer_result != -2 ? 'answer_result': ''}}{{answer_result}} {{right_answer == 1 && answer_result == 0 && show_correct_answer == 1 ? 'answer_result1': ''}}" bindtap="tapOption" style="cursor: pointer;" hover-class="button-pressed" hover-start-time="20" hover-stay-time="80">A：{{option_a}}</view>
			<view wx:if="{{option_b}}" data-i="2" class="option-common {{selected_option == 2?'option_selected': ''}} {{ selected_option == 2 && answer_result != -1 && answer_result != -2 ? 'answer_result': ''}}{{answer_result}} {{right_answer == 2 && answer_result == 0 && show_correct_answer == 1 ? 'answer_result1': ''}}" bindtap="tapOption" style="cursor: pointer;" hover-class="button-pressed" hover-start-time="20" hover-stay-time="80">B：{{option_b}}</view>
			<view wx:if="{{option_c}}" data-i="3" class="option-common {{selected_option == 3?'option_selected': ''}} {{ selected_option == 3 && answer_result != -1 && answer_result != -2 ? 'answer_result': ''}}{{answer_result}} {{right_answer == 3 && answer_result == 0 && show_correct_answer == 1 ? 'answer_result1': ''}}" bindtap="tapOption" style="cursor: pointer;" hover-class="button-pressed" hover-start-time="20" hover-stay-time="80">C：{{option_c}}</view>
			<view wx:if="{{option_d}}" data-i="4" class="option-common {{selected_option == 4?'option_selected': ''}} {{ selected_option == 4 && answer_result != -1 && answer_result != -2 ? 'answer_result': ''}}{{answer_result}} {{right_answer == 4 && answer_result == 0 && show_correct_answer == 1 ? 'answer_result1': ''}}" bindtap="tapOption" style="cursor: pointer;" hover-class="button-pressed" hover-start-time="20" hover-stay-time="80">D：{{option_d}}</view>
		</view>
		<view wx:if="{{option_type == 1}}">
			<view wx:if="{{option_a}}" data-i="1" class="option-common {{selected_option == 1?'option_selected': ''}} {{ selected_option == 1 && answer_result != -1 && answer_result != -2 ? 'answer_result': ''}}{{answer_result}} {{right_answer == 1 && answer_result == 0 && show_correct_answer == 1 ? 'answer_result1': ''}}" style="display: flex;cursor: pointer;" bindtap="tapOption" hover-class="button-pressed" hover-start-time="20" hover-stay-time="80">
				<text style="display: flex;align-items: center;" data-i="1">A：</text>
				<image src="{{option_a}}" class="image-option" data-i="1" mode="widthFix" />
			</view>
			<view wx:if="{{option_b}}" data-i="2" class="option-common {{selected_option == 2?'option_selected': ''}} {{ selected_option == 2 && answer_result != -1 && answer_result != -2 ? 'answer_result': ''}}{{answer_result}} {{right_answer == 2 && answer_result == 0 && show_correct_answer == 1 ? 'answer_result1': ''}}" style="display: flex;cursor: pointer;" bindtap="tapOption" hover-class="button-pressed" hover-start-time="20" hover-stay-time="80">
				<text style="display: flex;align-items: center;" data-i="2">B：</text>
				<image src="{{option_b}}" class="image-option" data-i="2" mode="widthFix" />
			</view>
			<view wx:if="{{option_c}}" data-i="3" class="option-common {{selected_option == 3?'option_selected': ''}} {{ selected_option == 3 && answer_result != -1 && answer_result != -2 ? 'answer_result': ''}}{{answer_result}} {{right_answer == 3 && answer_result == 0 && show_correct_answer == 1 ? 'answer_result1': ''}}" style="display: flex;cursor: pointer;" bindtap="tapOption" hover-class="button-pressed" hover-start-time="20" hover-stay-time="80">
				<text style="display: flex;align-items: center;" data-i="3">C：</text>
				<image src="{{option_c}}" class="image-option" data-i="3" mode="widthFix" />
			</view>
			<view wx:if="{{option_d}}" data-i="4" class="option-common {{selected_option == 4?'option_selected': ''}} {{ selected_option == 4 && answer_result != -1 && answer_result != -2 ? 'answer_result': ''}}{{answer_result}} {{right_answer == 4 && answer_result == 0 && show_correct_answer == 1 ? 'answer_result1': ''}}" style="display: flex;cursor: pointer;" bindtap="tapOption" hover-class="button-pressed" hover-start-time="20" hover-stay-time="80">
				<text style="display: flex;align-items: center;" data-i="4">D：</text>
				<image src="{{option_d}}" class="image-option" data-i="4" mode="widthFix" />
			</view>
		</view>
		<view class="answer-actions">
			<view class="count_down_num {{count_down <= 5 ? 'countdown-urgent' : ''}}">{{count_down}}</view>
			<view style="cursor: pointer;" bindtap="submitAnswer" class="sub_button {{sub_button_active}}">确认</view>
		</view>
		<view wx:if="{{answer_result == 0 && analysis && show_analysis}}" class="answer-analysis">
			<text class="analysis-label">解析：</text>
			<rich-text space="true" nodes="{{analysis}}" wx:if="{{ tools.indexOf(analysis, '/>') || tools.indexOf(analysis, '</')}}"></rich-text>
			<text wx:else="">{{analysis}}</text>
		</view>
	</view>
  <view class="question-share-row"><button class="question-share-button" bindtap="openQuestionPoster" disabled="{{answer_result == -1 || answer_result == -2}}" hover-class="button-pressed" hover-start-time="20" hover-stay-time="80"><image src="/images/ui-share.png" class="question-share-icon" />{{answer_result == -1 || answer_result == -2 ? '作答后生成海报' : '生成分享海报'}}</button></view>
</view>
<view wx:if="{{show_login}}">
	<view class="login" bindtap="toLogin" style="cursor: pointer;">点击登录</view>
</view>
<report class="report" show_feedback="{{show_feedback}}" bindnextQuestion="nextQuestionAfterCloseFeedback" question_id="{{current_question_id}}" />
<popup class="popup_compon" binderror="popupCancel" bindsuccess="popupConfirm"></popup>

<ui-feedback state="{{ui_feedback}}" />

<question-poster id="question-poster" bind:close="onQuestionPosterClose" />

<view class="page-shell illustrated-empty" wx:if="{{entry_error}}"><image class="empty-illustration" src="/images/ui-empty-question.png" mode="aspectFit" /><view class="empty-title">这道题暂时打不开</view><view class="empty-description">{{entry_error}}</view><button class="question-share-button" bindtap="returnToChallenge" hover-class="button-pressed" hover-start-time="20" hover-stay-time="80">返回挑战首页</button></view>
