.current_score {
  flex: 1;
  text-align: center;
  font-size: 26px;
  font-weight: 800;
  color: #2056ce;
}
.sub_button {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: auto;
  width: 64%;
  min-height: 50px;
  border: 1px solid #d4dff5;
  border-radius: 14px;
  background: #edf3ff;
  color: #2056ce;
  font-weight: 600;
  font-size: 16px;
}
.sub_button_active {
  background: #2864eb;
  border-color: #2864eb;
  color: #fff;
  box-shadow: 0 4px 12px rgba(40, 100, 235, 0.16);
}
.login {
  text-align: center;
  width: 200px;
  min-height: 52px;
  line-height: 52px;
  border-radius: 16px;
  margin: 64px auto;
  background: #2864eb;
  color: #fff;
  font-weight: 600;
}
.count_down_num {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 54px;
  width: 54px;
  border: 3px solid #dce6fc;
  border-radius: 50%;
  font-size: 22px;
  font-weight: 800;
  color: #2056ce;
}
.countdown-urgent {
  color: #ad3542;
  border-color: #f3ced2;
  background: #fff4f4;
}
