.current_score {
  flex: 1;
  text-align: center;
  font-size: 26px;
  font-weight: 800;
  color: #2056ce;
}
.sub_button {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: auto;
  width: 64%;
  min-height: 50px;
  border: 1px solid #d4dff5;
  border-radius: 14px;
  background: #edf3ff;
  color: #2056ce;
  font-weight: 600;
  font-size: 16px;
}
.sub_button_active {
  background: #2864eb;
  border-color: #2864eb;
  color: #fff;
  box-shadow: 0 4px 12px rgba(40, 100, 235, 0.16);
}
.login {
  text-align: center;
  width: 200px;
  min-height: 52px;
  line-height: 52px;
  border-radius: 16px;
  margin: 64px auto;
  background: #2864eb;
  color: #fff;
  font-weight: 600;
}
.count_down_num {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 54px;
  width: 54px;
  border: 3px solid #dce6fc;
  border-radius: 50%;
  font-size: 22px;
  font-weight: 800;
  color: #2056ce;
}
.countdown-urgent {
  color: #ad3542;
  border-color: #f3ced2;
  background: #fff4f4;
}

.challenge-completion {
  margin-top: 18px;
  padding: 22px;
}
.challenge-completion__title {
  color: #202b40;
  font-size: 18px;
  font-weight: 600;
}
.challenge-completion__description {
  display: block;
  margin-top: 8px;
  color: #68758a;
  font-size: 14px;
  line-height: 1.7;
}
.challenge-completion__actions {
  display: flex;
  gap: 12px;
  margin-top: 18px;
}
.challenge-completion button {
  flex: 1;
  margin: 0;
  padding: 11px 10px;
  border: 0;
  border-radius: 12px;
  background: #edf3ff;
  color: #2056ce;
  font-size: 14px;
  line-height: 1.6;
}
.challenge-completion button::after {
  border: 0;
}
.challenge-completion button.challenge-completion__primary {
  background: #2864eb;
  color: #fff;
}
.challenge-completion > button {
  margin-top: 18px;
}

.popup-correction-entry {
  display: flex;
  align-items: center;
  justify-content: space-around;
  flex-shrink: 0;
  padding: 0 23px 14px;
}
.popup-correction-entry .popup-correction-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: auto;
  min-height: 36px;
  margin: 0;
  padding: 6px 0;
  border: 0;
  background: transparent;
  color: #68758a;
  font-size: 13px;
  line-height: 24px;
}
.popup-correction-button::after {
  border: none;
}
.popup-correction-button image {
  width: 16px;
  height: 16px;
  margin-right: 6px;
}
