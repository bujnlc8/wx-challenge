.mine-page {
  padding-top: 8px;
}
.profile-card {
  padding: 24px 20px;
}
.profile-heading,
.guest-profile {
  display: flex;
  align-items: center;
}
.avatar,
.default-avatar {
  display: block;
  width: 60px;
  height: 60px;
  border-radius: 20px;
  background: #edf2fa;
}
.default-avatar {
  margin-right: 16px;
}
.avatar-wrapper {
  flex-shrink: 0;
  width: 60px !important;
  height: 60px !important;
  padding: 0 !important;
  margin: 0 16px 0 0 !important;
  border-radius: 20px;
  background: transparent;
}
.profile-name {
  flex: 1;
  min-width: 0;
}
.nickname-input {
  height: 36px;
  line-height: 36px;
  font-size: 20px;
  font-weight: 700;
  width: 100%;
}
.profile-caption {
  font-size: 12px;
  color: #68758a;
  margin-top: 4px;
}
.guest-title {
  font-size: 20px;
  font-weight: 700;
  display: inline-block;
  padding: 6px 0;
}
.stats-grid {
  display: flex;
  margin-top: 24px;
  padding-top: 24px;
  border-top: 1px solid #edf1f6;
}
.stat-cell {
  flex: 1;
  min-width: 0;
  text-align: center;
}
.stat-value {
  display: block;
  font-size: 20px;
  line-height: 1.4;
  font-weight: 800;
  word-break: break-all;
}
.stat-label {
  display: block;
  font-size: 12px;
  color: #68758a;
  margin-top: 6px;
}
.grade-row {
  display: flex;
  align-items: center;
  min-height: 28px;
  margin-top: 2px;
}
.grade-progress-label {
  flex: 1;
  min-width: 0;
  font-size: 12px;
  font-weight: 400;
  line-height: 1.6;
  word-break: break-all;
  color: #68758a;
}
.grade-crest {
  display: block;
  flex-shrink: 0;
  width: 22px;
  height: 22px;
  margin-right: 8px;
}
.grade-progress {
  margin-bottom: 12px;
  padding: 12px 14px;
  border-radius: 12px;
  background: #edf3ff;
  color: #48618d;
  font-size: 13px;
  line-height: 1.8;
}
.menu-group {
  margin-top: 16px;
  padding: 8px 18px;
  overflow: hidden;
}
.menu {
  color: #202b40;
  display: flex;
  align-items: center;
  min-height: 56px;
  padding: 6px 0;
  font-size: 15px;
}
.menu-icon {
  display: block;
  flex-shrink: 0;
  width: 22px;
  height: 22px;
  margin-right: 12px;
}
.menu-label {
  flex: 1;
  min-width: 0;
}
.menu-caption {
  max-width: 46%;
  margin-left: 12px;
  text-align: right;
  word-break: break-all;
  color: inherit;
  font-size: 12px;
}
.coin-balance {
  color: inherit;
  font-weight: 600;
}
.menu-count {
  color: inherit;
  font-size: 12px;
}
.right-arrow {
  width: 24px;
  height: 24px;
  margin-left: 8px;
  opacity: 0.5;
  flex-shrink: 0;
}
.category-sheet {
  position: fixed;
  display: flex;
  flex-direction: column;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10002;
  max-height: 85vh;
  border-radius: 24px 24px 0 0;
  overflow: hidden;
  background: #fff;
  box-shadow: 0 -12px 48px rgba(20, 38, 70, 0.12);
}
.category-options-scroll {
  height: auto;
  max-height: calc(82vh - 190px);
  min-height: 0;
  flex: 0 1 auto;
  overflow-y: auto;
}
.category-options {
  display: flex;
  flex-wrap: wrap;
  padding: 0 18px 12px;
}
.category-option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: calc(50% - 12px);
  min-height: 54px;
  padding: 12px;
  margin: 6px;
  border: 1px solid #e3e9f2;
  border-radius: 12px;
  background: #f8faff;
  color: #4e5c72;
}
.category-option-selected {
  border-color: #2864eb;
  background: #edf3ff;
  color: #2056ce;
  font-weight: 600;
}
.category-option-label {
  min-width: 0;
  word-break: break-all;
  font-size: 14px;
}
.category-radio {
  flex-shrink: 0;
  width: 18px;
  height: 18px;
  border: 1px solid #c4cedd;
  border-radius: 50%;
  margin-left: 8px;
}
.category-option-selected .category-radio {
  border: 5px solid #2864eb;
  background: #fff;
}
.category-actions {
  padding-bottom: calc(24px + env(safe-area-inset-bottom));
}
.table-item {
  display: flex;
  text-align: center;
  font-size: 14px;
  color: #4e5c72;
}
.tr-item {
  flex: 1;
  border: 1px solid #e3e9f2;
  border-bottom: none;
  padding: 7px 0;
}
.tr-right {
  border-left: none;
}
.table-item:last-of-type .tr-item {
  border-bottom: 1px solid #e3e9f2;
}
.about-item {
  font-size: 14px;
  line-height: 1.9;
  color: #4e5c72;
  padding-bottom: 12px;
}
.oneplus {
  color: #2056ce;
  font-weight: 700;
}

.grade-current {
  margin-bottom: 10px;
  color: #35435a;
  font-size: 15px;
  font-weight: 600;
}

.menu {
  font-family:
    -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue",
    "Microsoft Yahei", sans-serif;
  font-size: 15px;
  font-weight: 400;
  line-height: 24px;
  color: #202b40;
}

.menu-label {
  font-family: inherit;
  font-size: 15px;
  font-weight: 400;
  line-height: 24px;
  color: #202b40;
  letter-spacing: 0;
}
.menu-caption,
.menu-count,
.coin-balance {
  font-family: inherit;
  font-size: 13px;
  font-weight: 400;
  line-height: 22px;
  color: #68758a;
  letter-spacing: 0;
}
