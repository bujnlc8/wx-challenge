<view class="board" wx:if="{{show_tip == 1 || category_sheet_visible}}" catchtouchmove="catchtouchmove"></view>
<view class="page-shell mine-page">
  <view class="page-title">我的知识档案</view><view class="page-subtitle">每一份积累，都有迹可循</view>
  <view wx:if="{{logined == 0}}" class="profile-card surface guest-profile">
    <image src="../../images/default_avatar.png" class="default-avatar" bindtap="login" />
    <view><text class="guest-title" bindtap="login">点击登录</text><view class="profile-caption">登录后开启你的知识挑战</view></view>
  </view>
  <view class="menu-section" wx:if="{{logined == 0}}">
    <view class="menu-section-title">帮助与关于</view>
    <view class="menu-group surface">
      <view class="menu" bindtap="showHelp" hover-class="button-pressed" hover-start-time="0" hover-stay-time="80"><text class="menu-label">使用帮助</text><image src="../../images/right_arrow.png" class="right-arrow" /></view>
      <view class="menu" bindtap="aboutMe" hover-class="button-pressed" hover-start-time="0" hover-stay-time="80"><text class="menu-label">关于小程序</text><image src="../../images/right_arrow.png" class="right-arrow" /></view>
    </view>
  </view>
  <view wx:if="{{logined == 1}}" class="profile-card surface">
    <view class="profile-heading">
      <button class="avatar-wrapper" open-type="chooseAvatar" bind:chooseavatar="chooseAvatar" hover-class="button-pressed" hover-start-time="0" hover-stay-time="80"><image src="{{user_info.avatar}}" class="avatar" /></button>
      <view class="profile-name"><input class="nickname-input" type="nickname" placeholder="请输入昵称" value="{{user_info.nickname}}" bindblur="updateNickname" bindconfirm="updateNickname" bindinput="inputNickname" /></view>
    </view>
    <view class="stats-grid">
      <view class="stat-cell"><text class="stat-value" bindtap="tapMaxScore">{{user_info.max_score}}</text><text class="stat-label" bindtap="tapMaxScore">最高分</text></view>
      <view class="stat-cell"><text class="stat-value" bindtap="tapQuestionNum">{{user_info.total_question}}</text><text class="stat-label" bindtap="tapQuestionNum">答题数</text></view>
      <view class="stat-cell"><text class="stat-value" bindtap="tapWrongQuestion">{{user_info.wrong_question}}</text><text class="stat-label" bindtap="tapWrongQuestion">错题数</text></view>
      <view class="stat-cell"><text class="stat-value" bindtap="tapCorrectRate">{{correct_rate}}%</text><text class="stat-label" bindtap="tapCorrectRate">正确率</text></view>
    </view>
  </view>
  <view class="wallet-card" wx:if="{{logined == 1}}">
    <view class="wallet-heading" bindtap="goToCoin" hover-class="button-pressed" hover-start-time="0" hover-stay-time="80"><view><view class="wallet-label">我的百科币</view><view class="wallet-value">{{user_info.coin}}<text class="wallet-unit">个</text></view></view><view class="wallet-detail">查看明细<image src="../../images/right_arrow.png" class="right-arrow" /></view></view>
    <view class="grade-row" bindtap="openTip" hover-class="button-pressed" hover-start-time="0" hover-stay-time="80"><image src="/images/ui-grade-{{user_info.grade || 0}}.png" class="grade-crest" mode="aspectFit" /><text class="grade-badge">{{user_info.grade}} 级</text><text class="grade-help">等级说明</text></view>
    <view class="upgrade-note" bindtap="openTip" hover-class="button-pressed" hover-start-time="0" hover-stay-time="80">距离下一级还需{{user_info.to_upgrade_coin}}个百科币</view>
  </view>
  <view wx:if="{{logined == 1}}" class="mine-menus">
    <view class="menu-section">
      <view class="menu-section-title">学习工具</view>
      <view class="menu-group surface">
        <view class="menu" bindtap="goToDaily" hover-class="button-pressed" hover-start-time="0" hover-stay-time="80"><text class="menu-label">每日挑战</text><text class="menu-caption">早上 08:00 提醒</text><image src="../../images/right_arrow.png" class="right-arrow" /></view>
        <view wx:if="{{user_info.wrong_valid_question > 0}}" class="menu" bindtap="goToWrongQuestion" hover-class="button-pressed" hover-start-time="0" hover-stay-time="80"><text class="menu-label">错题集</text><text class="menu-count">{{user_info.wrong_valid_question}}</text><image src="../../images/right_arrow.png" class="right-arrow" /></view>
      </view>
    </view>
    <view class="menu-section">
      <view class="menu-section-title">答题偏好</view>
      <view class="menu-group surface">
        <view class="menu" bindtap="openCategorySheet" hover-class="button-pressed" hover-start-time="0" hover-stay-time="80"><text class="menu-label">题目类型</text><text class="menu-caption">{{categories[category]}}</text><image src="../../images/right_arrow.png" class="right-arrow" /></view>
        <view class="menu" bindtap="goToSetting" hover-class="button-pressed" hover-start-time="0" hover-stay-time="80"><text class="menu-label">设置</text><text class="menu-caption">{{is_ios ? '音效提示等' : '背景音效等'}}</text><image src="../../images/right_arrow.png" class="right-arrow" /></view>
      </view>
    </view>
    <view class="menu-section">
      <view class="menu-section-title">帮助与关于</view>
      <view class="menu-group surface">
        <view class="menu" bindtap="showHelp" hover-class="button-pressed" hover-start-time="0" hover-stay-time="80"><text class="menu-label">使用帮助</text><image src="../../images/right_arrow.png" class="right-arrow" /></view>
        <view class="menu" bindtap="aboutMe" hover-class="button-pressed" hover-start-time="0" hover-stay-time="80"><text class="menu-label">关于小程序</text><image src="../../images/right_arrow.png" class="right-arrow" /></view>
      </view>
    </view>
  </view>
</view>
<view class="pop-tip" wx:if="{{show_tip == 1}}" bindlongpress="closeTip">
  <view class="dialog-header">
    <view class="pop-tip-title">等级说明</view>
    <button class="dialog-close" bindtap="closeTip" aria-label="关闭等级说明" hover-class="button-pressed" hover-start-time="0" hover-stay-time="80"><view class="close-mark"></view></button>
    <view class="dialog-intro">百科币积累越多，挑战权益越丰富</view>
  </view>
  <view class="dialog-scroll"><view class="dialog-body">
    <view class="rule-item">（1）等级与百科币数量相关，随数量动态变化；</view>
    <view class="rule-item">（2）每增加1个等级，答题超时秒数 <text class="oneplus">+1</text>，复活次数 <text class="oneplus">+1</text>，跳过次数 <text class="oneplus">+1</text>；</view>
    <view class=" rule-item">（3）答题得分按照等级进行相应加倍，1级 * <text class="oneplus">1.1</text>，2级 * <text class="oneplus">1.2</text> ... 以此类推。</view>
    <view class="table-item">
        <view class="tr-item">数量</view>
        <view class="tr-item tr-right">等级</view>
    </view>
    <view class="table-item">
        <view class="tr-item">0-1w</view>
        <view class="tr-item tr-right">0级</view>
    </view>
    <view class="table-item">
        <view class="tr-item">1w-5w</view>
        <view class="tr-item tr-right">1级</view>
    </view>
    <view class="table-item">
        <view class="tr-item">5w-10w</view>
        <view class="tr-item tr-right">2级</view>
    </view>
    <view class="table-item">
        <view class="tr-item">10w-50w</view>
        <view class="tr-item tr-right">3级</view>
    </view>
    <view class="table-item">
        <view class="tr-item">50w-200w</view>
        <view class="tr-item tr-right">4级</view>
    </view>
    <view class="table-item">
        <view class="tr-item">200w-1000w</view>
        <view class="tr-item tr-right">5级</view>
    </view>
    <view class="table-item">
        <view class="tr-item" style="border-bottom: 1px solid #e6e6e6">>=1000w</view>
        <view class="tr-item tr-right" style="border-bottom: 1px solid #e6e6e6">6级</view>
    </view>
  </view></view>
  <view class="dialog-footer"><view class="iknow" bindtap="closeTip" hover-class="button-pressed" hover-start-time="0" hover-stay-time="80">知道了</view></view>
</view>
<view class="category-sheet" wx:if="{{category_sheet_visible}}">
  <view class="dialog-header">
    <view class="pop-tip-title">题目类型</view>
    <button class="dialog-close" bindtap="cancelCategorySheet" aria-label="取消选择" hover-class="button-pressed" hover-start-time="0" hover-stay-time="80"><view class="close-mark"></view></button>
    <view class="dialog-intro">选择感兴趣的类型，确认后生效</view>
  </view>
  <view class="category-options-scroll">
    <view class="category-options">
      <view wx:for="{{category_lables}}" wx:key="index" class="category-option {{category_draft == index ? 'category-option-selected' : ''}}" data-index="{{index}}" bindtap="chooseCategoryDraft" aria-role="radio" aria-checked="{{category_draft == index}}" hover-class="button-pressed" hover-start-time="0" hover-stay-time="80"><text class="category-option-label">{{item}}</text><view class="category-radio"></view></view>
    </view>
  </view>
  <view class="dialog-footer dialog-actions category-actions"><button class="dialog-action dialog-action-secondary" bindtap="cancelCategorySheet" hover-class="button-pressed" hover-start-time="0" hover-stay-time="80">取消</button><button class="dialog-action" bindtap="confirmCategorySheet" hover-class="button-pressed" hover-start-time="0" hover-stay-time="80">确认</button></view>
</view>

<ui-feedback state="{{ui_feedback}}" />
