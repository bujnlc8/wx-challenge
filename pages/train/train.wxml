<page-meta page-style="{{(modal_locked) ? 'overflow: hidden;' : ''}}" />
<view class="practice-page">
  <scroll-view class="practice-content" scroll-y="true" enhanced="true" show-scrollbar="false">
    <view class="page-shell">
      <view class="practice-intro">
        <view class="practice-title">自在练习，慢慢积累</view>
        <view class="practice-copy">没有倒计时的压力，按自己的节奏探索</view>
        <view class="practice-meta"><text class="practice-chip">不限时</text><text class="practice-chip">不计分</text></view>
        <view class="practice-progress">
          <block wx:if="{{practice_progress_state == 'ready'}}">
            <view class="practice-progress-heading"><text>今日已练</text><view><text class="practice-progress-count">{{practice_progress.answered_count}}</text><text class="practice-progress-target"> / {{practice_progress.target_count}}</text></view></view>
            <view class="practice-progress-track" aria-label="今日已练{{practice_progress.answered_count}}道，目标{{practice_progress.target_count}}道"><view class="practice-progress-fill" style="width: {{practice_progress_percent}}%;"></view></view>
            <view class="practice-progress-caption {{practice_progress.reward_received ? 'practice-reward-received' : ''}}">{{practice_reward_text}}</view>
          </block>
          <view wx:elif="{{practice_progress_state == 'logged-out'}}" class="practice-progress-caption">登录后记录今日进度</view>
          <view wx:elif="{{practice_progress_state == 'error'}}" class="practice-progress-error"><text>今日进度暂时打不开</text><button class="practice-progress-retry" bindtap="loadPracticeProgress" hover-class="button-pressed">重试</button></view>
          <view wx:else class="practice-progress-caption">正在加载今日进度…</view>
        </view>
      </view>
      <view class="practice-guide surface">
        <view class="practice-guide-title">练习规则</view>
        <view class="practice-rule"><text class="practice-rule-index">1</text><view class="practice-rule-text">每题不限时，计时但不计分。</view></view>
        <view class="practice-rule"><text class="practice-rule-index">2</text><view class="practice-rule-text">答错的题将计入错题集，但不计入“我的”页面“错题数”等数据。</view></view>
        <view class="practice-rule"><text class="practice-rule-index">3</text><view class="practice-rule-text">每日练习达<text class="hi-num">100</text>道不同题目，送<text class="hi-num">10000</text>百科币，每天限领一次。</view></view>
        <view class="practice-rule"><text class="practice-rule-index">4</text><view class="practice-rule-text">长按题目可永久跳过，每日限<text class="hi-num">5</text>次机会。</view></view>
        <view class="practice-rule"><text class="practice-rule-index">5</text><view class="practice-rule-text">对题目有任何疑问，随时点击答题页底部“纠错”提交。</view></view>
      </view>
    </view>
  </scroll-view>
  <view class="practice-dock">
    <view bindtap="goToTrain" class="train-btn primary-button" hover-class="button-pressed" hover-start-time="20" hover-stay-time="80">开始练习</view>
  </view>
</view>
<ui-feedback state="{{ui_feedback}}" />
