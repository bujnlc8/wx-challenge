.practice-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
}
.practice-content {
  flex: 1;
  min-height: 0;
  height: 0;
}
.practice-content .page-shell {
  padding-top: 8px;
  padding-bottom: 24px;
}
.practice-intro {
  padding: 18px 20px;
  border-radius: 22px;
  background: #eaf1ff;
}
.practice-title {
  color: #1e4388;
  font-size: 22px;
  font-weight: 800;
}
.practice-copy {
  margin-top: 6px;
  color: #48618d;
  font-size: 13px;
}
.practice-meta {
  display: flex;
  align-items: center;
  margin-top: 12px;
}
.practice-chip {
  margin-right: 8px;
  padding: 4px 10px;
  border-radius: 8px;
  background: #fff;
  color: #2056ce;
  font-size: 12px;
}
.practice-guide {
  margin-top: 16px;
  padding: 20px;
}
.practice-guide-title {
  margin-bottom: 16px;
  color: #202b40;
  font-size: 16px;
  font-weight: 700;
}
.practice-rule {
  display: flex;
  align-items: flex-start;
  margin-top: 16px;
}
.practice-rule-index {
  display: block;
  flex-shrink: 0;
  box-sizing: border-box;
  width: 20px;
  height: 20px;
  line-height: 20px;
  margin: 3px 12px 0 0;
  border-radius: 6px;
  background: #edf3ff;
  color: #48618d;
  font-size: 12px;
  text-align: center;
}
.practice-rule-text {
  flex: 1;
  min-width: 0;
  color: #4e5c72;
  font-size: 14px;
  line-height: 1.85;
}
.practice-dock {
  flex-shrink: 0;
  padding: 12px 20px 14px;
  border-top: 1px solid #e8edf5;
  background: #f5f7fb;
}
.train-btn {
  width: 100%;
}
@media (max-height: 680px) {
  .practice-intro {
    padding: 16px 20px;
  }
  .practice-meta {
    margin-top: 10px;
  }
}
@media (max-height: 560px) {
  .practice-intro {
    padding: 14px 16px;
  }
  .practice-title {
    font-size: 20px;
  }
  .practice-copy {
    display: none;
  }
  .practice-meta {
    margin-top: 6px;
  }
}
