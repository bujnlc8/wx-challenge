.practice-intro {
  padding: 32px 24px;
  margin-top: 24px;
  border-radius: 24px;
  background: #eaf1ff;
}
.practice-symbol {
  display: flex;
  align-items: center;
  margin-bottom: 24px;
}
.practice-symbol view {
  width: 36px;
  height: 48px;
  border: 2px solid #2864eb;
  background: #fff;
}
.practice-symbol view:first-child {
  border-radius: 5px 0 0 9px;
  transform: skewY(-8deg);
  border-right-width: 1px;
}
.practice-symbol view:last-child {
  border-radius: 0 5px 9px 0;
  transform: skewY(8deg);
  border-left-width: 1px;
}
.practice-title {
  font-size: 26px;
  font-weight: 800;
  color: #1e4388;
}
.practice-copy {
  color: #48618d;
  font-size: 14px;
  margin-top: 8px;
}
.practice-features {
  display: flex;
  padding: 24px 0;
}
.practice-feature {
  flex: 1;
  text-align: center;
  border-right: 1px solid #e3e9f2;
}
.practice-feature:last-child {
  border: none;
}
.feature-value {
  display: block;
  color: #202b40;
  font-size: 18px;
  font-weight: 700;
}
.feature-label {
  display: block;
  color: #68758a;
  font-size: 12px;
  margin-top: 4px;
}
.train-btn {
  margin-top: 24px;
  width: 100%;
}
.practice-footnote {
  margin-top: 12px;
  font-size: 12px;
  color: #68758a;
  text-align: center;
}
.practice-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
}
.practice-content {
  flex: 1;
  min-height: 0;
  height: 0;
}
.practice-content .page-shell {
  padding-bottom: 24px;
}
.practice-dock {
  flex-shrink: 0;
  padding: 12px 20px 14px;
  background: #f5f7fb;
  border-top: 1px solid #e8edf5;
}
.practice-dock .train-btn {
  margin-top: 0;
}
.practice-dock .practice-footnote {
  margin-top: 8px;
}

.practice-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}
.practice-heading-copy {
  flex: 1;
  min-width: 0;
}
.practice-rules-link {
  flex-shrink: 0;
  width: 76px;
  height: 36px;
  line-height: 36px;
  padding: 0;
  margin: 0 0 0 10px;
  border-radius: 10px;
  background: transparent;
  color: #2056ce;
  font-size: 13px;
  font-weight: 500;
}
@media (max-width: 350px) {
  .practice-heading .page-title {
    font-size: 22px;
  }
  .practice-heading .page-subtitle {
    font-size: 12px;
  }
}
