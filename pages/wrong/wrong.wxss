.wrong-heading {
  padding: 24px 20px 16px;
}
.answer-legend {
  display: flex;
  align-items: center;
  padding: 0 20px 20px;
  color: #68758a;
  font-size: 12px;
}
.legend-swatch {
  width: 12px;
  height: 12px;
  border-radius: 4px;
  margin-right: 6px;
  border: 1px solid #eaa7aa;
  background: #fff0f0;
}
.legend-correct {
  margin-left: 24px;
  border-color: #84c7a6;
  background: #eaf8f1;
}
.question {
  padding: 24px 20px;
  margin: 0 20px 16px;
  border-radius: 20px;
  background: #fff;
}
.option {
  padding: 10px 12px;
  margin-top: 10px;
  background: #f5f7fb;
  border: 1px solid transparent;
  border-radius: 10px;
  line-height: 1.8;
  word-break: break-word;
  font-size: 15px;
}
.question-footer {
  display: flex;
  align-items: center;
  flex-wrap: nowrap;
  margin-top: 16px;
  padding-top: 14px;
  border-top: 1px solid #edf1f6;
}
.question-date {
  display: block;
  flex: 1;
  min-width: 0;
  margin-right: 10px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  color: #68758a;
  font-size: 12px;
}
.question-action-icon {
  flex-shrink: 0;
  width: 16px;
  height: 16px;
  margin-right: 5px;
}
.question-action {
  flex-shrink: 0;
  white-space: nowrap;
  font-size: 12px;
  color: #48618d;
  padding: 6px 0;
}
.report-action-icon {
  margin-left: 12px;
}

.question-footer-share {
  margin-left: 12px;
}

.wrong-favorite-action {
  display: flex;
  flex-shrink: 0;
  margin-left: 8px;
}

.wrong-question-heading {
  display: flex;
  align-items: flex-start;
}
.wrong-question-heading .question_body {
  flex: 1;
  min-width: 0;
}
