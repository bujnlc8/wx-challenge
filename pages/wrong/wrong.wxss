.wrong-heading {
  padding: 24px 20px 16px;
}
.answer-legend {
  display: flex;
  align-items: center;
  padding: 0 20px 20px;
  color: #68758a;
  font-size: 12px;
}
.legend-swatch {
  width: 12px;
  height: 12px;
  border-radius: 4px;
  margin-right: 6px;
  border: 1px solid #eaa7aa;
  background: #fff0f0;
}
.legend-correct {
  margin-left: 24px;
  border-color: #84c7a6;
  background: #eaf8f1;
}
.question {
  padding: 24px 20px;
  margin: 0 20px 16px;
  border-radius: 20px;
  background: #fff;
}
.option {
  padding: 10px 12px;
  margin-top: 10px;
  background: #f5f7fb;
  border: 1px solid transparent;
  border-radius: 10px;
  line-height: 1.8;
  word-break: break-word;
  font-size: 15px;
}
.question-footer {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  margin-top: 16px;
  padding-top: 14px;
  border-top: 1px solid #edf1f6;
}
.question-date {
  width: 100%;
  margin-bottom: 10px;
  color: #68758a;
  font-size: 12px;
}
.question-action-icon {
  width: 16px;
  height: 16px;
  margin-right: 5px;
}
.question-action {
  font-size: 12px;
  color: #48618d;
  padding: 6px 0;
}
.report-action-icon {
  margin-left: auto;
}
