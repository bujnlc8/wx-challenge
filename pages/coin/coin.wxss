@import "../../styles/history-state.wxss";
.coin-page {
  padding-bottom: 32px;
}
.coin-header {
  padding: 20px;
}
.coin-records {
  margin: 0 20px;
  padding: 0 16px;
  border-radius: 20px;
  background: #fff;
}
.coin-record {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  min-height: 80px;
  padding: 16px 0;
  box-sizing: border-box;
  border-bottom: 1px solid #edf1f6;
}
.coin-record:last-child {
  border-bottom: 0;
}
.coin-record__details {
  flex: 1;
  min-width: 0;
}
.coin-record__source {
  display: block;
  color: #202b40;
  font-size: 15px;
  font-weight: 500;
  line-height: 1.6;
  word-break: break-word;
}
.coin-record__time {
  display: block;
  margin-top: 5px;
  color: #68758a;
  font-size: 12px;
  line-height: 1.6;
  word-break: break-word;
}
.coin-record__amount {
  flex-shrink: 0;
  color: #68758a;
  font-size: 19px;
  font-weight: 600;
  line-height: 1.4;
  font-variant-numeric: tabular-nums;
}
.coin-record__income {
  color: #2864eb;
}
