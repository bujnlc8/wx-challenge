.home {
  padding: 8px 18px 0;
  height: 100vh;
  min-height: 440px;
}
.challenge-intro {
  flex-shrink: 0;
  padding: 15px 18px;
  background: linear-gradient(125deg, #edf4ff 0%, #e3edff 100%);
  border-radius: 20px;
  margin-bottom: 12px;
}
.intro-brand {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.intro-logo {
  display: block;
  width: 36px;
  height: 36px;
  flex-shrink: 0;
  margin-left: 10px;
  border-radius: 11px;
  box-shadow: 0 4px 12px rgba(40, 100, 235, 0.14);
}
.intro-title {
  font-size: 22px;
  line-height: 30px;
  font-weight: 800;
  color: #1e4388;
}
.intro-copy {
  margin-top: 4px;
  font-size: 13px;
  line-height: 20px;
  color: #5c7398;
}
.intro-meta {
  display: flex;
  align-items: center;
  margin-top: 10px;
  padding-top: 8px;
  border-top: 1px solid rgba(40, 100, 235, 0.1);
}
.intro-settings {
  flex: 1;
  min-width: 0;
  padding-right: 12px;
}
.intro-category {
  color: #2056ce;
  font-size: 13px;
  line-height: 20px;
  word-break: break-all;
}
.intro-count {
  color: #354f7d;
  font-size: 13px;
  line-height: 20px;
}
.intro-label {
  color: #6a7d9c;
  font-size: 11px;
  margin-right: 8px;
}
.rules-link {
  flex-shrink: 0;
  font-size: 12px;
  color: #2056ce;
  min-height: 40px;
  line-height: 40px;
}
.ranking-heading {
  display: flex;
  align-items: center;
  height: 42px;
  flex-shrink: 0;
}
.ranking-heading .section-title {
  width: 48px;
  margin-right: 10px;
  font-size: 16px;
  line-height: 24px;
  flex-shrink: 0;
}
.ranking-refresh {
  color: #8390a4;
  font-size: 11px;
  line-height: 18px;
  margin-left: 8px;
  flex-shrink: 0;
}
.ranking-retry {
  color: #2056ce;
}
.ranking-tabs {
  display: flex;
  flex: 1;
  min-width: 0;
  background: #e9edf5;
  border-radius: 12px;
  padding: 4px;
  flex-shrink: 0;
}
.tab {
  flex: 1;
  text-align: center;
  padding: 6px 4px;
  font-size: 14px;
  line-height: 22px;
  border-radius: 9px;
  color: #68758a;
}
.tab-active {
  background: #fff;
  font-weight: 600;
  color: #2056ce;
  box-shadow: 0 2px 6px rgba(30, 55, 95, 0.06);
}
.ranking-info {
  display: flex;
  align-items: center;
  height: 18px;
  margin: 8px 0;
  flex-shrink: 0;
}
.reset-note {
  flex: 1;
  min-width: 0;
  font-size: 11px;
  line-height: 18px;
  color: #68758a;
}
.ranking-labels {
  display: flex;
  color: #8390a4;
  font-size: 11px;
  line-height: 18px;
  padding: 0 12px 6px;
  flex-shrink: 0;
}
.label-player {
  flex: 1;
  padding-left: 32px;
}
.label-score,
.player-score {
  width: 66px;
  text-align: right;
  flex-shrink: 0;
}
.label-count,
.player-count {
  width: 38px;
  text-align: right;
  flex-shrink: 0;
}
.ranking-list {
  flex: 1;
  min-height: 64px;
  height: 0;
  width: 100%;
}
.ranking-item {
  min-height: 62px;
  margin-bottom: 6px;
  padding: 8px 12px;
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 14px;
}
.ranking-item:first-child {
  background: #fffaf0;
}
.index-class {
  display: block;
  width: 24px;
  flex-shrink: 0;
  text-align: center;
  margin-right: 8px;
  color: #68758a;
  font-size: 13px;
  line-height: 26px;
  font-weight: 700;
}
.other-place {
  font-size: 12px;
}
.first-place,
.second-place,
.third-place {
  height: 26px;
  border-radius: 8px;
}
.first-place {
  color: #a7680e;
  background: #f9e4b4;
}
.second-place {
  color: #536582;
  background: #e8edf5;
}
.third-place {
  color: #a15d38;
  background: #fae8dd;
}
.avatar-wrap {
  position: relative;
  width: 32px;
  height: 32px;
  margin-right: 8px;
  flex-shrink: 0;
}
.avatar_class {
  display: block;
  width: 32px;
  height: 32px;
  border-radius: 11px;
  background: #edf1f7;
}
.grade-icon {
  position: absolute;
  right: -3px;
  bottom: -3px;
  width: 13px;
  height: 13px;
}
.player-name {
  display: block;
  flex: 1;
  min-width: 0;
  color: #35435a;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: 13px;
}
.player-score {
  display: block;
  font-size: 13px;
  color: #202b40;
  font-weight: 700;
  white-space: nowrap;
}
.player-count {
  display: block;
  font-size: 11px;
  color: #68758a;
  white-space: nowrap;
}
.home-bottom {
  flex-shrink: 0;
  padding: 10px 0 12px;
}
.my-ranking {
  background: #eaf0fc;
  margin-bottom: 8px;
  min-height: 64px;
}
.my-ranking:first-child {
  background: #eaf0fc;
}
.personal-identity {
  flex: 1;
  min-width: 0;
}
.personal-note {
  color: #68758a;
  font-size: 10px;
  line-height: 16px;
}
.personal-note.ranking-retry {
  color: #2056ce;
}
.personal-login {
  color: #2056ce;
  font-size: 13px;
  margin-left: 8px;
}
.start_challenge_class {
  width: 100%;
}
.ranking-state {
  padding: 24px 8px;
  text-align: center;
}
.state-title {
  color: #536582;
  font-size: 14px;
  line-height: 22px;
}
.state-description {
  color: #8390a4;
  font-size: 12px;
  margin-top: 4px;
}
.ranking-retry-button {
  color: #2056ce;
  background: #eaf1ff;
  font-size: 13px;
  line-height: 36px;
  width: 108px;
  padding: 0;
  border-radius: 10px;
  margin: 14px auto 0;
}
.ranking-empty-image {
  width: 96px;
  height: 72px;
  display: block;
  margin: 0 auto 8px;
}
.ranking-skeleton {
  background: #fff;
}
.ranking-skeleton:first-child {
  background: #fff;
}
.skeleton-rank,
.skeleton-avatar,
.skeleton-name,
.skeleton-score {
  background: #edf1f7;
  border-radius: 6px;
}
.skeleton-rank {
  width: 24px;
  height: 18px;
  margin-right: 8px;
  flex-shrink: 0;
}
.skeleton-avatar {
  width: 32px;
  height: 32px;
  border-radius: 11px;
  margin-right: 8px;
  flex-shrink: 0;
}
.skeleton-name {
  width: 30%;
  height: 14px;
}
.skeleton-score {
  width: 56px;
  height: 14px;
  margin-left: auto;
}
@media (max-width: 340px) {
  .home {
    padding-left: 14px;
    padding-right: 14px;
  }
  .challenge-intro {
    padding-left: 14px;
    padding-right: 14px;
  }
  .intro-title {
    font-size: 21px;
  }
  .ranking-item {
    padding-left: 10px;
    padding-right: 10px;
  }
  .ranking-labels {
    padding-left: 10px;
    padding-right: 10px;
  }
}
@media (max-height: 560px) {
  .challenge-intro {
    padding-top: 11px;
    padding-bottom: 11px;
    margin-bottom: 10px;
  }
  .intro-title {
    font-size: 20px;
    line-height: 26px;
  }
  .intro-logo {
    width: 32px;
    height: 32px;
    border-radius: 10px;
  }
  .intro-copy {
    margin-top: 2px;
    font-size: 12px;
    line-height: 18px;
  }
  .intro-meta {
    margin-top: 6px;
    padding-top: 5px;
  }
  .intro-category,
  .intro-count {
    line-height: 18px;
  }
  .ranking-heading {
    height: 38px;
  }
  .tab {
    padding-top: 4px;
    padding-bottom: 4px;
  }
  .ranking-info {
    margin: 5px 0;
  }
  .home-bottom {
    padding-top: 8px;
    padding-bottom: 10px;
  }
  .my-ranking {
    min-height: 60px;
  }
  .start_challenge_class {
    min-height: 48px;
  }
}

.my-ranking .other-place {
  width: auto;
  min-width: 24px;
  font-size: 11px;
}
@media (max-height: 480px) {
  .home {
    padding-top: 4px;
  }
  .challenge-intro {
    padding-top: 10px;
    padding-bottom: 10px;
  }
  .ranking-info {
    margin-top: 4px;
    margin-bottom: 4px;
  }
  .home-bottom {
    padding-bottom: 8px;
  }
}
