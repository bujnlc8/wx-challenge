<page-meta page-style="{{(modal_locked || show_tip) ? 'overflow: hidden;' : ''}}" />
<view class="board" catchtap="catchtouchmove" wx:if="{{show_tip}}" catchtouchmove="catchtouchmove"></view>
<view class="container home">
  <view class="challenge-intro">
    <view class="intro-title">知识无界，挑战不停</view>
    <view class="intro-copy">用你的知识储备，刷新自己的纪录</view>
    <view class="intro-meta"><text class="intro-chip">限时答题</text><text class="intro-chip">积分排行</text><text class="rules-link" bindtap="openTip">挑战规则</text></view>
  </view>
  <view class="ranking-heading"><text class="section-title">排行榜</text><text class="section-caption">与答题高手一起进步</text></view>
  <view class="ranking-tabs">
    <view class="tab {{t == 0 ? 'tab-active': '' }}" data-t="0" bindtap="changeTab">本周排行榜</view>
    <view class="tab {{t == 1 ? 'tab-active': '' }}" data-t="1" bindtap="changeTab">历史高分榜</view>
  </view>
  <view wx:if="{{t == 0}}" class="reset-note">下次重置：<text wx:if="{{reset_day > 0}}">{{reset_day}}天 </text>{{reset_hour}} 时 {{reset_minute}}分</view>
  <view wx:if="{{t == 1}}" class="reset-note">高分榜不重置，上榜至少需要2000分</view>
  <view class="ranking-labels"><text class="label-player">排名 / 挑战者</text><text class="label-score">积分</text><text class="label-count">答题</text></view>
  <scroll-view class="ranking-list" scroll-y="true" enhanced="true" show-scrollbar="false">
    <view class="ranking-item" wx:for="{{current_rank_list}}" wx:key="index">
      <text class="index-class {{index == 0 ? 'first-place': index==1 ? 'second-place':index==2 ? 'third-place': 'other-place'}}">{{index + 1}}</text>
      <view class="avatar-wrap">
        <image class="avatar_class" src="{{item.avatar_url}}" />
        <image src="/images/ui-grade-{{item.grade}}.png" class="grade-icon" wx:if="{{item.grade > 0}}" />
        <image src="/images/ui-grade-0.png" class="grade-icon" wx:else="" />
      </view>
      <text class="player-name">{{item.nickname}}</text><text class="player-score">{{item.total_score}}分</text><text class="player-count">{{item.total_question}}题</text>
    </view>
    <view wx:if="{{current_rank_list.length == 0}}" class="illustrated-empty"><image class="empty-illustration" src="/images/ui-empty-ranking.png" mode="aspectFit" /><view class="empty-title">榜单还在等待第一位挑战者</view><view class="empty-description">开启挑战，让你的知识闪光</view></view>
  </scroll-view>
  <view class="home-bottom">
    <view wx:if="{{logined == 1 && mine}}" class="ranking-item my-ranking">
      <text class="index-class {{my_rank == 1 ? 'first-place': my_rank==2 ? 'second-place':my_rank==3 ? 'third-place': 'other-place'}}">{{my_rank}}</text>
      <view class="avatar-wrap">
        <image class="avatar_class" src="{{mine.avatar_url}}" />
        <image src="/images/ui-grade-{{mine.grade}}.png" class="grade-icon" wx:if="{{mine.grade > 0}}" />
        <image src="/images/ui-grade-0.png" class="grade-icon" wx:else="" />
      </view>
      <text class="player-name">{{mine.nickname || ''}}</text>
      <text class="player-score" wx:if="{{mine.total_score != -1}}">{{mine.total_score || 0}}分</text>
      <text class="player-count" wx:if="{{mine.total_score != -1}}">{{mine.total_question || 0}}题</text>
      <text class="empty-record" wx:if="{{mine.total_score == -1}}">暂无答题记录</text>
    </view>
    <view wx:else="" class="ranking-item my-ranking" bindtap="goToLogin">
      <text class="index-class other-place">99...</text>
      <view class="avatar-wrap"><image class="avatar_class" src="/images/default_avatar.png" /><image src="/images/ui-grade-0.png" class="grade-icon" /></view>
      <text class="player-name">请登录后答题</text>
    </view>
    <text bindtap="startChallenge" class="primary-button start_challenge_class" hover-class="button-pressed" hover-start-time="20" hover-stay-time="80">开始挑战</text>
  </view>
  <view class="pop-tip" catchtap="catchtouchmove" wx:if="{{show_tip}}" bindlongpress="closeTip">
    <view class="dialog-header">
      <view class="pop-tip-title">挑战模式说明</view>
      <button class="dialog-close" bindtap="closeTip" aria-label="关闭挑战规则" hover-class="button-pressed" hover-start-time="20" hover-stay-time="80"><view class="close-mark"></view></button>
      <view class="dialog-intro">了解计分与奖励，开始你的知识挑战</view>
    </view>
    <view class="dialog-scroll"><view class="dialog-body">
		<view class="rule-item">（1）时间限时<text class="hi-num">30</text>秒
			，超时自动判为错误<text class="common-gray underline-class" bindtap="goToClassIntro" style="cursor: pointer;">（见等级说明）</text>；</view>
		<view class="rule-item">（2）用时越短，分数越高<text class="common-gray">（该题得分 = 倒计时秒数* 10 * 等级倍数，</text><text class="common-gray underline-class" bindtap="goToClassIntro" style="cursor: pointer;">见等级说明）</text>；</view>
		<view class="rule-item">（3）回答错误，消耗<text class="hi-num">1000</text>百科币可复活，每轮限1次机会<text class="common-gray underline-class" bindtap="goToClassIntro" style="cursor: pointer;">（见等级说明）</text>；</view>
		<view class="rule-item">（4）每日首次答题，送<text class="hi-num">1000</text>百科币；</view>
		<view class="rule-item">（5）每答对1题送「该题得分 / 5」个百科币，每答对<text class="hi-num">100</text>题(去重)，额外送<text class="hi-num">10000</text>百科币。答的越多，送的越多！</view>
		<view class="rule-item">（6）点击右上角按钮本轮可跳过该题，每日限<text class="hi-num">1</text>次机会<text class="common-gray underline-class" bindtap="goToClassIntro" style="cursor: pointer;">（见等级说明）</text>；</view>
		<view class="rule-item">（7）长按题目可永久跳过，每日限<text class="hi-num">5</text>次机会；</view>
		<view class="rule-item">（8）对题目有任何疑问，欢迎点击左上角按钮进行反馈，成功将送500百科币；<text class="common-gray">（不限次数）</text></view>
    </view></view>
    <view class="dialog-footer"><view class="iknow" bindtap="closeTip" hover-class="button-pressed" hover-start-time="20" hover-stay-time="80">知道了</view></view>
  </view>
</view>

<ui-feedback state="{{ui_feedback}}" />
