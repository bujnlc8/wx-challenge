<page-meta page-style="{{modal_locked ? 'overflow: hidden;' : ''}}" />
<wxs src="../../utils/util.wxs" module="tools" />
<view class="single-page {{view_state === 'ready' ? 'quiz-page' : ''}}">
  <view wx:if="{{view_state === 'ready'}}">
    <view class="quiz-header"><view class="quiz-header__top"><text class="quiz-mode">单题模式</text><view class="quiz-clock"><view class="quiz-clock__icon"></view><text>用时 {{elapsed_text}}</text></view></view></view>
    <view class="question-common quiz-card"><view class="question_body"><rich-text wx:if="{{tools.isRichQuestion(content)}}" nodes="{{tools.questionHtml(content)}}" space="true" /><text wx:else>{{content}}</text></view><image wx:if="{{question_image && !is_video}}" src="{{question_image}}" class="image-question" mode="aspectFit" bindtap="previewQuestionImage" /><video wx:if="{{question_image && is_video}}" src="{{question_image}}" class="video-option" object-fit="contain" /></view>
    <view class="quiz-section-heading"><text>选择答案</text><text class="quiz-section-hint">单选</text></view>
    <view class="quiz-options">
      <view wx:for="{{options}}" wx:key="number" class="option-common quiz-option {{selected_option === item.number ? 'option_selected' : ''}} {{phase === 'completed' && selected_option === item.number ? (result === 1 ? 'answer_result1' : 'answer_result0') : ''}} {{phase === 'completed' && show_correct_answer && right_answer === item.number ? 'answer_result1' : ''}}" data-number="{{item.number}}" bindtap="tapOption" aria-role="radio" aria-checked="{{selected_option === item.number}}" hover-class="quiz-option-pressed"><text class="quiz-option__letter">{{item.label}}</text><view class="quiz-option__content"><image wx:if="{{option_type === 1}}" src="{{item.content}}" class="image-option" mode="widthFix" /><text wx:else>{{item.content}}</text></view><view class="quiz-option__indicator {{selected_option === item.number ? 'quiz-option__indicator-selected' : ''}}"></view></view>
    </view>
    <text wx:if="{{submit_error}}" class="single-submit-error">{{submit_error}}</text>
    <view wx:if="{{phase === 'completed'}}" id="single-result" class="single-result quiz-result-card"><view class="single-result__heading"><text>{{result === 1 ? '回答正确' : '本题未答对'}}</text><text class="single-result__score">{{score}}分</text></view><text class="single-result__caption">{{source === 'daily' ? '今日这一题已完成' : '本题作答已完成'}}</text><text wx:if="{{reward_coins > 0}}" class="single-result__reward">{{reward_coins}}百科币已入账</text><view wx:if="{{analysis && show_analysis}}" class="answer-analysis"><text class="analysis-label">答案解析</text><rich-text wx:if="{{tools.indexOf(analysis, '/>') || tools.indexOf(analysis, '</')}}" nodes="{{analysis}}" space="true" /><text wx:else>{{analysis}}</text></view></view>
    <view class="quiz-footer"><view class="quiz-footer__inner">
      <button wx:if="{{phase !== 'completed'}}" class="quiz-submit" bindtap="submitAnswer" disabled="{{phase === 'submitting' || (!selected_option && phase !== 'uncertain')}}"><view wx:if="{{phase === 'submitting'}}" class="quiz-button-spinner"></view>{{phase === 'submitting' ? '正在提交' : (phase === 'uncertain' ? '重试提交' : '确认答案')}}</button>
      <button wx:else class="quiz-submit" bindtap="returnToSource">{{source === 'daily' ? '返回每日挑战' : (source === 'favorite' ? '返回收藏夹' : '返回首页')}}</button>
      <view class="question-footer-actions">
        <button class="question-feedback-button" bindtap="openFeedback" hover-class="button-pressed"><image src="/images/report_error.png" class="question-footer-icon" />纠错</button>
        <question-favorite question_id="{{question_id}}" />
        <button class="question-share-button" bindtap="openQuestionPoster" hover-class="button-pressed"><image src="/images/ui-share.png" class="question-share-icon" />分享</button>
      </view>
    </view></view>
  </view>
  <view wx:else class="single-state"><view wx:if="{{view_state === 'loading'}}" class="single-spinner"></view><image wx:else src="/images/ui-empty-question.png" class="empty-illustration" mode="aspectFit" /><text class="single-state__title">{{view_state === 'loading' ? '正在准备题目' : (view_state === 'logged-out' ? '登录后开始答题' : '这道题暂时打不开')}}</text><text wx:if="{{view_state === 'error'}}" class="single-state__description">{{error_message}}</text><button wx:if="{{view_state === 'logged-out'}}" class="single-primary" bindtap="loginAndLoad">点击登录</button><button wx:if="{{view_state === 'error' && question_id}}" class="single-primary" bindtap="loadQuestion">重新加载</button><button wx:if="{{view_state !== 'loading'}}" class="single-feedback" bindtap="returnToSource">{{source === 'daily' ? '返回每日挑战' : (source === 'favorite' ? '返回收藏夹' : '返回首页')}}</button></view>
</view>
<report id="single-report" bind:nextQuestion="onFeedbackClosed" show_feedback="{{show_feedback}}" question_id="{{question_id}}" />
<question-poster id="question-poster" />
<ui-feedback state="{{ui_feedback}}" />
